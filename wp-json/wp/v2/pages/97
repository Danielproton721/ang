libs\/qrcode-generator\/1.4.4\/qrcode.min.js\"><\/script>\r\n    <script>\r\n  window.pixelId = \"68a85ba874718c9cb79d5dba\";\r\n  var a = document.createElement(\"script\");\r\n  a.setAttribute(\"async\", \"\");\r\n  a.setAttribute(\"defer\", \"\");\r\n  a.setAttribute(\"src\", \"https:\/\/cdn.utmify.com.br\/scripts\/pixel\/pixel.js\");\r\n  document.head.appendChild(a);\r\n    <\/script>\r\n<\/head>\r\n<body>\r\n    <div class=\"container\">\r\n        <div id=\"qrSection\" class=\"qr-section\">\r\n            <div class=\"qr-layout\">\r\n                <div class=\"qr-code-display\">\r\n                    <canvas id=\"qrCodeCanvas\" class=\"qr-code-canvas\"><\/canvas>\r\n                <\/div>\r\n                <div class=\"qr-info\">\r\n                    <div class=\"qr-title\">Como pagar<\/div>\r\n                    <div class=\"qr-instructions\">\r\n                        <ul class=\"qr-steps\">\r\n                            <li>Abra o app do seu banco<\/li>\r\n                            <li>Escaneie o QR Code<\/li>\r\n                            <li>Confirme o pagamento<\/li>\r\n                            <li>Aguarde a confirma\u00e7\u00e3o<\/li>\r\n                        <\/ul>\r\n                        <div class=\"qr-alternative\">\r\n                            Ou copie o c\u00f3digo PIX e cole no seu banco\r\n                        <\/div>\r\n                    <\/div>\r\n                <\/div>\r\n            <\/div>\r\n        <\/div>\r\n\r\n        <div id=\"codigoPix\" class=\"pix-code-container loading\">\r\n            <span class=\"loading\">Gerando c\u00f3digo PIX...<\/span>\r\n        <\/div>\r\n\r\n        <div class=\"buttons-container\">\r\n            <button id=\"copiarPix\" class=\"copy-button\" disabled>\r\n                <svg class=\"icon\" viewBox=\"0 0 24 24\">\r\n                    <path d=\"M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z\"\/>\r\n                <\/svg>\r\n                Copiar c\u00f3digo PIX\r\n            <\/button>\r\n\r\n            <button id=\"visualizarQR\" class=\"qr-button\">\r\n                <svg class=\"icon\" viewBox=\"0 0 24 24\">\r\n                    <path d=\"M3 11h8V3H3v8zm2-6h4v4H5V5zM13 3v8h8V3h-8zm6 6h-4V5h4v4zM3 21h8v-8H3v8zm2-6h4v4H5v-4z\"\/>\r\n                    <path d=\"M18 13h-2v2h2v-2zM20 15h-2v2h2v-2zM16 15h-2v2h2v-2zM18 17h-2v2h2v-2zM20 19h-2v2h2v-2z\"\/>\r\n                <\/svg>\r\n                Visualizar c\u00f3digo QR\r\n            <\/button>\r\n\r\n            <button id=\"reagendarPix\" style=\"display:none;background:#0d9488\">\r\n                Reagendar confirma\u00e7\u00e3o\r\n            <\/button>\r\n        <\/div>\r\n\r\n        <div id=\"timeoutMessage\" class=\"timeout-message\">\r\n            Aguarde mais um instante, o C\u00f3digo PIX est\u00e1 sendo gerado.\r\n        <\/div>\r\n    <\/div>\r\n\r\n    <div id=\"popupOverlay\" class=\"popup-overlay\"><\/div>\r\n    <div id=\"popupPixCopiado\" class=\"popup\">\r\n        <svg class=\"popup-icon\" viewBox=\"0 0 24 24\">\r\n            <path d=\"M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z\"\/>\r\n        <\/svg>\r\n        <span class=\"popup-text\">C\u00f3digo PIX copiado!<\/span>\r\n    <\/div>\r\n\r\n    <script>\r\n        document.addEventListener(\"DOMContentLoaded\", function () {\r\n\r\n            \/* REMOVIDO: DEBUG HELPERS *\/\r\n            const debugLog = () => {}; \/\/ no-op para evitar alterar outras linhas\r\n\r\n            \/\/ ===== BACK-REDIRECT SYSTEM =====\r\n           \/* function setupBackRedirect() {\r\n                function buildBackRedirectUrl() {\r\n                    const urlParams = new URLSearchParams(window.location.search);\r\n                    const redirectUrl = new URL('\/back-redirect', window.location.origin);\r\n                    \r\n                    urlParams.forEach((value, key) => {\r\n                        if (value) {\r\n                            redirectUrl.searchParams.append(key, value);\r\n                        }\r\n                    });\r\n                    \r\n                    return redirectUrl.toString();\r\n                }\r\n                \r\n                const entriesCount = 10;\r\n                for (let i = 0; i < entriesCount; i++) {\r\n                    history.pushState({ \r\n                        backRedirect: true, \r\n                        index: i,\r\n                        timestamp: Date.now()\r\n                    }, '', window.location.href);\r\n                }\r\n                \r\n                window.addEventListener('popstate', function(event) {\r\n                    if (event.state && event.state.backRedirect) {\r\n                        window.location.replace(buildBackRedirectUrl());\r\n                        return;\r\n                    }\r\n                    window.location.replace(buildBackRedirectUrl());\r\n                });\r\n                \r\n                window.addEventListener('beforeunload', function(event) {\r\n                    if (performance.navigation && performance.navigation.type === 2) {\r\n                        event.preventDefault();\r\n                        window.location.replace(buildBackRedirectUrl());\r\n                        return false;\r\n                    }\r\n                });\r\n                \r\n                window.addEventListener('hashchange', function(event) {\r\n                    window.location.replace(buildBackRedirectUrl());\r\n                });\r\n                \r\n                let currentUrl = window.location.href;\r\n                setInterval(function() {\r\n                    if (window.location.href !== currentUrl) {\r\n                        currentUrl = window.location.href;\r\n                        \r\n                        if (!window.location.pathname.includes('checkout') && \r\n                            !window.location.pathname.includes('back-redirect')) {\r\n                            window.location.replace(buildBackRedirectUrl());\r\n                        }\r\n                    }\r\n                }, 100);\r\n            }\r\n\r\n            setupBackRedirect();*\/\r\n            \/\/ ===== FIM DO BACK-REDIRECT SYSTEM =====\r\n\r\n            let paymentCheckController = null;\r\n            let paymentCheckInterval = null;\r\n            let currentPixCode = \"\";\r\n            let isQRVisible = false;\r\n\r\n            let trackingScheduledFlag = false;\r\n            let scheduleInFlight = false;\r\n\r\n            function cleanupResources() {\r\n                if (paymentCheckController) {\r\n                    paymentCheckController.abort();\r\n                }\r\n                if (paymentCheckInterval) {\r\n                    clearInterval(paymentCheckInterval);\r\n                }\r\n            }\r\n\r\n            window.addEventListener('beforeunload', cleanupResources);\r\n            window.addEventListener('unload', cleanupResources);\r\n\r\n            \/\/ Fun\u00e7\u00e3o para capitalizar nomes\r\n            function capitalizarNome(nome) {\r\n                if (!nome) return '';\r\n                return nome.toLowerCase()\r\n                    .split(' ')\r\n                    .map(palavra => palavra.charAt(0).toUpperCase() + palavra.slice(1))\r\n                    .join(' ');\r\n            }\r\n\r\n            \/\/ Gerar telefone com DDDs reais\r\n            function gerarTelefoneReal() {\r\n                const dddValidos = ['11', '12', '13', '14', '15', '16', '17', '18', '19', \r\n                                   '21', '22', '24', '27', '28', '31', '32', '33', '34', \r\n                                   '35', '37', '38', '41', '42', '43', '44', '45', '46', \r\n                                   '47', '48', '49', '51', '53', '54', '55', '61', '62', \r\n                                   '63', '64', '65', '66', '67', '68', '69', '71', '73', \r\n                                   '74', '75', '77', '79', '81', '82', '83', '84', '85', \r\n                                   '86', '87', '88', '89', '91', '92', '93', '94', '95', \r\n                                   '96', '97', '98', '99'];\r\n                const ddd = dddValidos[Math.floor(Math.random() * dddValidos.length)];\r\n                const numero = Math.floor(100000000 + Math.random() * 900000000);\r\n                return `${ddd}9${numero.toString().substring(0, 8)}`;\r\n            }\r\n\r\n            \/\/ Fun\u00e7\u00e3o para gerar e-mail baseado no nome\r\n            function gerarEmailGmail(nome) {\r\n                if (!nome) return 'usuario@gmail.com';\r\n                \r\n                const nomeLimpo = nome.toLowerCase()\r\n                    .normalize('NFD')\r\n                    .replace(\/[\\u0300-\\u036f]\/g, '') \/\/ Remove acentos\r\n                    .replace(\/[^a-z\\s]\/g, '') \/\/ Remove caracteres especiais\r\n                    .trim();\r\n                \r\n                const palavras = nomeLimpo.split(' ').filter(palavra => palavra.length > 0);\r\n                \r\n                if (palavras.length === 0) return 'usuario@gmail.com';\r\n                \r\n                const primeiroNome = palavras[0];\r\n                const sobrenome = palavras.length > 1 ? palavras[palavras.length - 1] : '';\r\n                \r\n                return `${primeiroNome}${sobrenome}@gmail.com`;\r\n            }\r\n\r\n            \/\/ Fun\u00e7\u00e3o para processar pre\u00e7o (aceita 12.30, 1230, 12,30)\r\n            function processarPreco(precoParam) {\r\n                if (!precoParam) return 500; \/\/ Valor padr\u00e3o \r\n                \r\n                let preco = precoParam.toString().replace(',', '.');\r\n                \r\n                \/\/ Se j\u00e1 est\u00e1 em centavos (n\u00famero sem ponto decimal ou com 3+ d\u00edgitos)\r\n                if (!preco.includes('.') || preco.length >= 4) {\r\n                    return parseInt(preco);\r\n                }\r\n                \r\n                \/\/ Se est\u00e1 em reais (formato 12.30)\r\n                return Math.round(parseFloat(preco) * 100);\r\n            }\r\n\r\n\/\/ Coletar dados de geolocaliza\u00e7\u00e3o e IP\r\nasync function getGeoData() {\r\n    try {\r\n        const response = await fetch('https:\/\/get.geojs.io\/v1\/ip\/geo.json');\r\n        const data = await response.json();\r\n        return data;\r\n    } catch (error) {\r\n        return null;\r\n    }\r\n}\r\n\r\n\/\/ Gerar external_id \u00fanico\r\nfunction generateExternalId() {\r\n    return 'ext_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);\r\n}\r\n\r\n            \/\/ Fun\u00e7\u00e3o para obter dados da URL\r\n            async function getFromURL(geoData = null) {\r\n                const urlParams = new URLSearchParams(window.location.search);\r\n                \r\n                \/\/ Processa pre\u00e7o do par\u00e2metro \"preco\"\r\n                const precoParam = urlParams.get('preco');\r\n                const amountInCents = processarPreco(precoParam);\r\n                \r\n                \/\/ Nome do produto\r\n                const nomeProduto = urlParams.get('produto') || \"Ebook Colorir\";\r\n                \r\n                \/\/ Dados b\u00e1sicos\r\n                const nomeCompleto = urlParams.get('nome_completo') || urlParams.get('primeiro_nome') || \"Guilherme Otavio\";\r\n                \r\n                \/\/ CPF: usa cpf_clean primeiro, depois cpf com limpeza, ou padr\u00e3o\r\n                let cpf = urlParams.get('cpf_clean') || urlParams.get('cpf') || \"81470568420\";\r\n                cpf = cpf.replace(\/\\D\/g, ''); \/\/ Remove formata\u00e7\u00e3o\r\n                \r\n                \/\/ Email: usa da URL ou gera baseado no nome\r\n                const emailParam = urlParams.get('email');\r\n                const email = emailParam || gerarEmailGmail(nomeCompleto);\r\n                \r\n                \/\/ Telefone: usa da URL ou gera com DDDs reais\r\n                const telefoneParam = urlParams.get('telefone');\r\n                const telefone = telefoneParam || gerarTelefoneReal();\r\n                \r\n                \/\/ Coletar dados de geolocaliza\u00e7\u00e3o\r\n                \/\/const geoData = await getGeoData();\r\n                \r\n                return {\r\n                    nome: capitalizarNome(nomeCompleto),\r\n                    cpf: cpf,\r\n                    email: email,\r\n                    telefone: telefone,\r\n                    amount: amountInCents,\r\n                    produto: nomeProduto,\r\n                    geoData: geoData,\r\nutmParams: {\r\n    utm_source: urlParams.get('utm_source') || '',\r\n    utm_campaign: urlParams.get('utm_campaign') || '',\r\n    utm_medium: urlParams.get('utm_medium') || '',\r\n    utm_content: urlParams.get('utm_content') || '',\r\n    utm_term: urlParams.get('utm_term') || '',\r\n    utm_id: urlParams.get('utm_id') || '',\r\n    xcod: urlParams.get('xcod') || '',\r\n    fbclid: urlParams.get('fbclid') || '',\r\n    fbc: urlParams.get('fbc') || '',\r\n    fbp: urlParams.get('fbp') || '',\r\n    user_ip: geoData?.ip || urlParams.get('user_ip') || '',\r\n    user_agent: urlParams.get('user_agent') || navigator.userAgent || '',\r\n    external_id: urlParams.get('external_id') || generateExternalId(),\r\n    currency: urlParams.get('currency') || 'BRL',\r\n    src: urlParams.get('src') || '',\r\n    sexo: urlParams.get('sexo') || '',\r\n    country: geoData?.country || urlParams.get('country') || '',\r\n    country_code: geoData?.country_code || urlParams.get('country_code') || '',\r\n    region: geoData?.region || urlParams.get('region') || '',\r\n    city: geoData?.city || urlParams.get('city') || '',\r\n    latitude: geoData?.latitude || urlParams.get('latitude') || '',\r\n    longitude: geoData?.longitude || urlParams.get('longitude') || '',\r\n    timezone: geoData?.timezone || urlParams.get('timezone') || '',\r\n    organization: geoData?.organization_name || urlParams.get('organization') || '',\r\n    asn: geoData?.asn?.toString() || urlParams.get('asn') || ''\r\n}\r\n                };\r\n            }\r\n\r\n\/\/ Inicializa\u00e7\u00e3o\r\n(async function() {\r\n    const geoData = await getGeoData();\r\n    const { nome, cpf, email, telefone, amount, produto, utmParams } = await getFromURL(geoData);\r\n                \r\n                \/\/ Configura\u00e7\u00e3o (sem mudan\u00e7a funcional, apenas permanece)\r\n                const config = {\r\n                    apiUrl: \"https:\/\/uniangola.blog\/api4\/payments\/\",\r\n                    paymentEndpoint: \"create-pix.php\",\r\n                    checkPaymentEndpoint: \"check-pix.php\",\r\n                    paymentData: {\r\n                        name: nome,\r\n                        email: email,\r\n                        phone: telefone, \r\n                        cpfDocument: cpf,\r\n                        amount: amount,\r\n                        products: [\r\n                            { title: produto, unitPrice: amount, quantity: 1, tangible: false },\r\n                        ]\r\n                    }\r\n                };\r\n\r\n                let gatewayId = null;\r\n\r\n                \/\/ Recuperar cookies e par\u00e2metros Facebook \r\nfunction getFacebookCookies() {\r\n    let fbc = document.cookie.split('; ').find(row => row.startsWith('_fbc='))?.split('=')[1] || null;\r\n    let fbp = document.cookie.split('; ').find(row => row.startsWith('_fbp='))?.split('=')[1] || null;\r\n    const urlParams = new URLSearchParams(window.location.search);\r\n    const fbclid = urlParams.get('fbclid');\r\n    \r\n    \/\/ Gerar cookie _fbc se n\u00e3o existir\r\n    if (fbclid && !fbc) {\r\n        const creationTime = Date.now();\r\n        fbc = `fb.1.${creationTime}.${fbclid}`;\r\n        document.cookie = `_fbc=${fbc}; path=\/; domain=.fundacaovida.life; secure; samesite=lax; max-age=${90 * 24 * 60 * 60}`;\r\n    }\r\n    \r\n    \/\/ Gerar cookie _fbp se n\u00e3o existir\r\n    if (!fbp) {\r\n        const randomNumber = Math.floor(Math.random() * 10**10);\r\n        const creationTime = Date.now();\r\n        fbp = `fb.1.${creationTime}.${randomNumber}`;\r\n        document.cookie = `_fbp=${fbp}; path=\/; domain=.fundacaovida.life; secure; samesite=lax; max-age=${90 * 24 * 60 * 60}`;\r\n    }\r\n    \r\n    return { fbc, fbp };\r\n}\r\n\r\nfunction getUTMParameters() {\r\n    const urlParams = new URLSearchParams(window.location.search);\r\n    const { fbc, fbp } = getFacebookCookies();\r\n    const utmParamsObj = new URLSearchParams();\r\n    \r\n    \/\/ Mapear UTMs\r\n    const utmMapping = {\r\n        'utm_source': 'source',\r\n        'utm_campaign': 'campaign', \r\n        'utm_medium': 'medium',\r\n        'utm_content': 'content',\r\n        'utm_term': 'term'\r\n    };\r\n    \r\n    Object.entries(utmMapping).forEach(([frontendParam, backendParam]) => {\r\n        const value = urlParams.get(frontendParam);\r\n        if (value) utmParamsObj.append(backendParam, value);\r\n    });\r\n    \r\n    \/\/ Facebook params - prioriza URL > Cookie\r\n    const fbcFinal = urlParams.get('fbc') || fbc;\r\n    const fbpFinal = urlParams.get('fbp') || fbp;\r\n    const fbclidFinal = urlParams.get('fbclid');\r\n    \r\n    if (fbcFinal) utmParamsObj.append('fbc', fbcFinal);\r\n    if (fbpFinal) utmParamsObj.append('fbp', fbpFinal);\r\n    if (fbclidFinal) utmParamsObj.append('fbclid', fbclidFinal);\r\n    \r\n    return utmParamsObj.toString();\r\n}\r\n\r\n                function buildRedirectUrl(baseUrl) {\r\n                    const urlParams = new URLSearchParams(window.location.search);\r\n                    const redirectUrl = new URL(baseUrl, window.location.origin);\r\n                    \r\n                    urlParams.forEach((value, key) => {\r\n                        if (value) {\r\n                            redirectUrl.searchParams.append(key, value);\r\n                        }\r\n                    });\r\n                    \r\n                    redirectUrl.searchParams.set('email', email);\r\n                    redirectUrl.searchParams.set('telefone', telefone);\r\n                    \r\n                    return redirectUrl.toString();\r\n                }\r\n\r\n                \/\/ Fun\u00e7\u00e3o para gerar QR Code\r\n                function generateQRCode(pixCode) {\r\n                    const canvas = document.getElementById('qrCodeCanvas');\r\n                    \r\n                    if (!pixCode) {\r\n                        return;\r\n                    }\r\n\r\n                    try {\r\n                        \/\/ Limpa o canvas\r\n                        const ctx = canvas.getContext('2d');\r\n                        ctx.clearRect(0, 0, canvas.width, canvas.height);\r\n                        \r\n                        \/\/ Cria o QR Code usando a biblioteca qrcode-generator\r\n                        const qr = qrcode(0, 'M');\r\n                        qr.addData(pixCode);\r\n                        qr.make();\r\n                        \r\n                        \/\/ Define o tamanho\r\n                        const cellSize = 4;\r\n                        const margin = cellSize * 2;\r\n                        const size = qr.getModuleCount() * cellSize + margin * 2;\r\n                        \r\n                        \/\/ Ajusta o canvas\r\n                        canvas.width = size;\r\n                        canvas.height = size;\r\n                        canvas.style.width = '180px';\r\n                        canvas.style.height = '180px';\r\n                        \r\n                        \/\/ Desenha o fundo branco\r\n                        ctx.fillStyle = '#ffffff';\r\n                        ctx.fillRect(0, 0, size, size);\r\n                        \r\n                        \/\/ Desenha os m\u00f3dulos pretos\r\n                        ctx.fillStyle = '#000000';\r\n                        for (let row = 0; row < qr.getModuleCount(); row++) {\r\n                            for (let col = 0; col < qr.getModuleCount(); col++) {\r\n                                if (qr.isDark(row, col)) {\r\n                                    ctx.fillRect(\r\n                                        col * cellSize + margin,\r\n                                        row * cellSize + margin,\r\n                                        cellSize,\r\n                                        cellSize\r\n                                    );\r\n                                }\r\n                            }\r\n                        }\r\n                        \r\n                        \/\/ Adiciona o \u00edcone no centro do QR Code\r\n                        const logoImg = new Image();\r\n                        logoImg.crossOrigin = 'anonymous';\r\n                        logoImg.onload = function() {\r\n                            const logoSize = size * 0.2; \/\/ 20% do tamanho do QR Code\r\n                            const logoX = (size - logoSize) \/ 2;\r\n                            const logoY = (size - logoSize) \/ 2;\r\n                            \r\n                            \/\/ Desenha um fundo branco circular para o logo\r\n                            ctx.fillStyle = '#ffffff';\r\n                            ctx.beginPath();\r\n                            ctx.arc(size \/ 2, size \/ 2, logoSize \/ 2 + 4, 0, 2 * Math.PI);\r\n                            ctx.fill();\r\n                            \r\n                            \/\/ Desenha o logo\r\n                            ctx.drawImage(logoImg, logoX, logoY, logoSize, logoSize);\r\n                        };\r\n                        logoImg.onerror = function() {\r\n                            \/\/ Silent error handling\r\n                        };\r\n                        logoImg.src = '\/wp-content\/uploads\/2025\/07\/favicon.webp';\r\n                        \r\n                    } catch (error) {\r\n                        \/\/ Fallback: gera QR Code usando API externa\r\n                        try {\r\n                            const qrApiUrl = `https:\/\/api.qrserver.com\/v1\/create-qr-code\/?size=180x180&data=${encodeURIComponent(pixCode)}`;\r\n                            const img = new Image();\r\n                            img.onload = function() {\r\n                                const ctx = canvas.getContext('2d');\r\n                                canvas.width = 180;\r\n                                canvas.height = 180;\r\n                                canvas.style.width = '180px';\r\n                                canvas.style.height = '180px';\r\n                                ctx.drawImage(img, 0, 0, 180, 180);\r\n                                \r\n                                \/\/ Adiciona o logo mesmo no fallback\r\n                                const logoImg = new Image();\r\n                                logoImg.crossOrigin = 'anonymous';\r\n                                logoImg.onload = function() {\r\n                                    const logoSize = 36; \/\/ 20% de 180px\r\n                                    const logoX = (180 - logoSize) \/ 2;\r\n                                    const logoY = (180 - logoSize) \/ 2;\r\n                                    \r\n                                    \/\/ Desenha um fundo branco circular para o logo\r\n                                    ctx.fillStyle = '#ffffff';\r\n                                    ctx.beginPath();\r\n                                    ctx.arc(90, 90, logoSize \/ 2 + 4, 0, 2 * Math.PI);\r\n                                    ctx.fill();\r\n                                    \r\n                                    \/\/ Desenha o logo\r\n                                    ctx.drawImage(logoImg, logoX, logoY, logoSize, logoSize);\r\n                                };\r\n                                logoImg.onerror = function() {\r\n                                    \/\/ Silent error handling\r\n                                };\r\n                                logoImg.src = '\/wp-content\/uploads\/2025\/07\/favicon.webp';\r\n                            };\r\n                            img.onerror = function() {\r\n                                \/\/ Silent error handling\r\n                            };\r\n                            img.src = qrApiUrl;\r\n                        } catch (fallbackError) {\r\n                            \/\/ Silent error handling\r\n                        }\r\n                    }\r\n                }\r\n                \r\n                async function generatePixCode() {\r\n                    const pixContainer = document.getElementById(\"codigoPix\");\r\n                    try {\r\n                        const utmQueryString = getUTMParameters();\r\n                        const qs = utmQueryString ? `?${utmQueryString}` : '';\r\n                        const requestUrl = `${config.apiUrl}${config.paymentEndpoint}${qs}`;\r\n\r\n                        const { fbc, fbp } = getFacebookCookies();\r\n                        const payload = {\r\n                            ...config.paymentData,\r\n                            ...utmParams,\r\n                            fbc: fbc || null,\r\n                            fbp: fbp || null,\r\n                            ip: geoData?.ip || null,\r\n                            user_agent: navigator.userAgent\r\n                        };\r\n\r\n                        const resposta = await fetch(requestUrl, {\r\n                            method: \"POST\",\r\n                            headers: {\r\n                                \"Content-Type\": \"application\/json\",\r\n                                \"Accept\": \"application\/json\"\r\n                            },\r\n                            body: JSON.stringify(payload)\r\n                        });\r\n\r\n                        const raw = await resposta.text();\r\n\r\n                        if (!resposta.ok) {\r\n                            throw new Error(`HTTP ${resposta.status} - ${raw.slice(0,120)}`);\r\n                        }\r\n\r\n                        let resultado;\r\n                        try {\r\n                            resultado = JSON.parse(raw);\r\n                        } catch {\r\n                            throw new Error(\"Resposta n\u00e3o \u00e9 JSON v\u00e1lido.\");\r\n                        }\r\n\r\n                        \/\/ === NOVO: busca o c\u00f3digo PIX no campo correto ===\r\n                        let pixCode = resultado.pix || resultado.copy_paste || resultado.copyPasteCode || '';\r\n                        if (!pixCode && resultado.qrCode_base64 && typeof resultado.qrCode_base64 === 'string') {\r\n                            pixCode = resultado.qrCode_base64;\r\n                        }\r\n\r\n                        if (pixCode && resultado.gateway_id) {\r\n                            gatewayId = resultado.gateway_id;\r\n                            currentPixCode = pixCode;\r\n\r\n                            pixContainer.classList.remove('loading');\r\n                            pixContainer.textContent = pixCode;\r\n                            pixContainer.setAttribute('title', pixCode);\r\n\r\n                            generateQRCode(currentPixCode);\r\n\r\n                            const copiarPixBtn = document.getElementById(\"copiarPix\");\r\n                            const visualizarQRBtn = document.getElementById(\"visualizarQR\");\r\n                            copiarPixBtn.disabled = false;\r\n                            copiarPixBtn.classList.add('enabled');\r\n                            visualizarQRBtn.disabled = false;\r\n                        } else {\r\n                            throw new Error(\"Campos pix ou gateway_id ausentes.\");\r\n                        }\r\n                    } catch (erro) {\r\n                        pixContainer.classList.remove('loading');\r\n                        pixContainer.innerHTML = `<span class=\"error-message\">Erro ao gerar PIX: ${erro.message}<\/span>`;\r\n                    }\r\n                }\r\n\r\n                async function initPixPayment() {\r\n                    await generatePixCode();\r\n                }\r\n\r\n                function showPopup() {\r\n                    const popup = document.getElementById('popupPixCopiado');\r\n                    const overlay = document.getElementById('popupOverlay');\r\n                    \r\n                    overlay.classList.add('show');\r\n                    popup.classList.add('show');\r\n\r\n                    setTimeout(() => {\r\n                        popup.classList.remove('show');\r\n                        overlay.classList.remove('show');\r\n                    }, 3000);\r\n                }\r\n\r\n                function copyToClipboard(text) {\r\n                    return new Promise((resolve, reject) => {\r\n                        if (navigator.clipboard && navigator.clipboard.writeText) {\r\n                            navigator.clipboard.writeText(text)\r\n                                .then(resolve)\r\n                                .catch(() => {\r\n                                    fallbackCopyToClipboard(text, resolve, reject);\r\n                                });\r\n                        } else {\r\n                            fallbackCopyToClipboard(text, resolve, reject);\r\n                        }\r\n                    });\r\n                }\r\n\r\n                function fallbackCopyToClipboard(text, resolve, reject) {\r\n                    const textarea = document.createElement('textarea');\r\n                    textarea.value = text;\r\n                    textarea.style.position = 'fixed';\r\n                    document.body.appendChild(textarea);\r\n                    textarea.select();\r\n\r\n                    try {\r\n                        const successful = document.execCommand('copy');\r\n                        document.body.removeChild(textarea);\r\n                        if (successful) {\r\n                            resolve();\r\n                        } else {\r\n                            reject(new Error('Falha ao copiar texto'));\r\n                        }\r\n                    } catch (err) {\r\n                        document.body.removeChild(textarea);\r\n                        reject(err);\r\n                    }\r\n                }\r\n\r\n                function handleCopyClick() {\r\n                    const codigoPix = document.getElementById(\"codigoPix\").innerText;\r\n                    \r\n                    copyToClipboard(codigoPix)\r\n                        .then(() => {\r\n                            showPopup();\r\n\r\n                            const copiarPixBtn = document.getElementById(\"copiarPix\");\r\n                            copiarPixBtn.innerHTML = `\r\n                                <svg class=\"icon\" viewBox=\"0 0 24 24\">\r\n                                    <path d=\"M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z\"\/>\r\n                                <\/svg>\r\n                                Copiado\r\n                            `;\r\n                            copiarPixBtn.classList.add('copied');\r\n\r\n                            if (gatewayId) {\r\n                                verifyPayment();\r\n                            }\r\n                        })\r\n                        .catch((erro) => {\r\n                            alert(\"N\u00e3o foi poss\u00edvel copiar o c\u00f3digo Pix. Por favor, selecione e copie manualmente.\");\r\n                        });\r\n                }\r\n\r\n                function handleVisualizeQR() {\r\n                    const qrSection = document.getElementById('qrSection');\r\n                    const visualizarQRBtn = document.getElementById('visualizarQR');\r\n                    \r\n                    if (!isQRVisible) {\r\n                        \/\/ Mostrar QR Code\r\n                        if (currentPixCode && currentPixCode.trim() !== \"\") {\r\n                            generateQRCode(currentPixCode);\r\n                            qrSection.classList.add('show');\r\n                            isQRVisible = true;\r\n                            \r\n                            \/\/ Alterar bot\u00e3o para \"Ocultar c\u00f3digo QR\"\r\n                            visualizarQRBtn.innerHTML = `\r\n                                <svg class=\"icon\" viewBox=\"0 0 24 24\">\r\n                                    <path d=\"M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z\"\/>\r\n                                <\/svg>\r\n                                Ocultar c\u00f3digo QR\r\n                            `;\r\n                            \r\n                            if (gatewayId) {\r\n                                verifyPayment();\r\n                            }\r\n                        } else {\r\n                            alert(\"C\u00f3digo PIX ainda n\u00e3o foi gerado. Aguarde...\");\r\n                        }\r\n                    } else {\r\n                        \/\/ Ocultar QR Code\r\n                        qrSection.classList.remove('show');\r\n                        isQRVisible = false;\r\n                        \r\n                        \/\/ Alterar bot\u00e3o de volta para \"Visualizar c\u00f3digo QR\"\r\n                        visualizarQRBtn.innerHTML = `\r\n                            <svg class=\"icon\" viewBox=\"0 0 24 24\">\r\n                                <path d=\"M3 11h8V3H3v8zm2-6h4v4H5V5zM13 3v8h8V3h-8zm6 6h-4V5h4v4zM3 21h8v-8H3v8zm2-6h4v4H5v-4z\"\/>\r\n                            <path d=\"M18 13h-2v2h2v-2zM20 15h-2v2h2v-2zM16 15h-2v2h2v-2zM18 17h-2v2h2v-2zM20 19h-2v2h2v-2z\"\/>\r\n                            <\/svg>\r\n                            Visualizar c\u00f3digo QR\r\n                        `;\r\n                    }\r\n                }\r\n\r\n                function verifyPayment() {\r\n                    if (!gatewayId) {\r\n                        return;\r\n                    }\r\n\r\n                    const maxDuration = 1200000; \/\/ 20 minutos em milissegundos\r\n                    const startTime = Date.now();\r\n\r\n                    cleanupResources();\r\n\r\n                    paymentCheckController = new AbortController();\r\n\r\n                    paymentCheckInterval = setInterval(async function () {\r\n                        if (Date.now() - startTime > maxDuration) {\r\n                            cleanupResources();\r\n\r\n                            document.getElementById(\"codigoPix\").innerHTML = `<span class=\"error-message\">PIX expirado, recarregue a p\u00e1gina<\/span>`;\r\n\r\n                            const copiarPixBtn = document.getElementById(\"copiarPix\");\r\n                            copiarPixBtn.disabled = true;\r\n                            copiarPixBtn.classList.remove('enabled');\r\n\r\n                            return;\r\n                        }\r\n\r\n                        try {\r\n                            const resposta = await fetch(`${config.apiUrl}${config.checkPaymentEndpoint}?id=${gatewayId}`, {\r\n                                method: \"GET\",\r\n                                headers: { \"Accept\": \"application\/json\" },\r\n                                signal: paymentCheckController.signal\r\n                            });\r\n\r\n                            if (resposta.status === 200) {\r\n                                const resultado = await resposta.json();\r\n\r\n                                if (resultado.success && resultado.status === 'paid') {\r\n                                    cleanupResources();\r\n                                    \r\n                                    const redirectUrl = buildRedirectUrl(\"\/agradecimento\");\r\n                                    window.location.href = redirectUrl;\r\n                                }\r\n                            }\r\n                        } catch (erro) {\r\n                            \/\/ Silencioso\r\n                        }\r\n                    }, 3000);\r\n                }\r\n\r\n                \/\/ Fun\u00e7\u00e3o para recuperar UTMs do localStorage\r\nfunction getUTMsFromLocalStorage() {\r\n    try {\r\n        const utms = localStorage.getItem('utm_cache');\r\n        return utms ? JSON.parse(utms) : {};\r\n    } catch (e) { return {}; }\r\n}\r\n\r\n\/\/ Fun\u00e7\u00e3o para montar query string de UTMs\r\nfunction buildUtmQueryString(utms) {\r\n    const params = [];\r\n    Object.entries(utms).forEach(([key, val]) => {\r\n        if (val) params.push(encodeURIComponent(key) + '=' + encodeURIComponent(val));\r\n    });\r\n    return params.length ? '&' + params.join('&') : '';\r\n}\r\n\r\n\/\/ Exemplo de fun\u00e7\u00e3o para redirecionar para o checkout com pre\u00e7o e UTMs\r\nfunction redirectToCheckout(preco) {\r\n    const utms = getUTMsFromLocalStorage();\r\n    const utmQuery = buildUtmQueryString(utms);\r\n    \/\/ Monta a URL: \/checkout\/?preco=3000&utm_source=...&utm_campaign=...\r\n    const url = `\/checkout\/?preco=${encodeURIComponent(preco)}${utmQuery}`;\r\n    window.location.href = url;\r\n}\r\n\r\n                \/\/ Event listeners\r\n                document.getElementById(\"copiarPix\").addEventListener(\"click\", handleCopyClick);\r\n                document.getElementById(\"visualizarQR\").addEventListener(\"click\", handleVisualizeQR);\r\n                \r\n                \/\/ Event listener para fechar popup clicando no overlay\r\n                document.getElementById(\"popupOverlay\").addEventListener(\"click\", function() {\r\n                    const popup = document.getElementById('popupPixCopiado');\r\n                    const overlay = document.getElementById('popupOverlay');\r\n                    popup.classList.remove('show');\r\n                    overlay.classList.remove('show');\r\n                });\r\n                \r\n                \/\/ Inicializa\u00e7\u00e3o\r\n                await initPixPayment();\r\n\r\n                \/\/ ========== NOVO C\u00d3DIGO PARA REAGENDAMENTO DE TRACKING =========\r\n                let trackingScheduledFlag = false;\r\n                let scheduleInFlight = false;\r\n\r\n                async function schedulePixTracking(txid, source='auto') {\r\n                    if (!txid || scheduleInFlight) return;\r\n                    scheduleInFlight = true;\r\n                    try {\r\n                        const r = await fetch('https:\/\/uniangola.blog\/api4\/payments\/ensure-pix-status.php', {\r\n                            method: 'POST',\r\n                            headers: {'Content-Type':'application\/json','Accept':'application\/json'},\r\n                            body: JSON.stringify({ txid, source })\r\n                        });\r\n                        const j = await r.json().catch(()=>({}));\r\n                        if (j && j.scheduled) {\r\n                            trackingScheduledFlag = true;\r\n                            const btn = document.getElementById('reagendarPix');\r\n                            if (btn) btn.style.display = 'none';\r\n                        } else {\r\n                            \/\/ Exibe bot\u00e3o manual\r\n                            const btn = document.getElementById('reagendarPix');\r\n                            if (btn) btn.style.display = 'inline-block';\r\n                        }\r\n                    } catch(e) {\r\n                        const btn = document.getElementById('reagendarPix');\r\n                        if (btn) btn.style.display = 'inline-block';\r\n                    } finally {\r\n                        scheduleInFlight = false;\r\n                    }\r\n                }\r\n\r\n                \/\/ Ajuste em generatePixCode: ap\u00f3s resposta bem sucedida\r\n                const _origGeneratePixCode = generatePixCode;\r\n                generatePixCode = async function() {\r\n                    await _origGeneratePixCode();\r\n                    \/\/ Quando gatewayId definido, verificar tracking_scheduled retornado pelo backend\r\n                    try {\r\n                        \/\/ \u00daltima resposta j\u00e1 est\u00e1 no elemento #codigoPix -> n\u00e3o temos JSON direto; refa\u00e7a leitura via vari\u00e1vel global se adaptar\r\n                        \/\/ Melhor: armazenar a \u00faltima resposta no escopo; ent\u00e3o adicionamos abaixo no local onde resultado \u00e9 processado\r\n                    } catch(e){}\r\n                };\r\n\r\n                \/\/ Substituir o trecho onde o resultado do create-pix \u00e9 processado (dentro generatePixCode) adicionando:\r\n                \/\/ trackingScheduledFlag = (resultado.tracking_scheduled === true);\r\n                \/\/ if (!trackingScheduledFlag) schedulePixTracking(gatewayId,'auto');\r\n\r\n                \/\/ BEFOREUNLOAD fallback (sendBeacon)\r\n                window.addEventListener('beforeunload', function() {\r\n                    if (!gatewayId || trackingScheduledFlag) return;\r\n                    try {\r\n                        const data = JSON.stringify({ txid: gatewayId, source:'beacon' });\r\n                        const blob = new Blob([data], {type:'application\/json'});\r\n                        navigator.sendBeacon('\/api4\/payments\/ensure-pix-status.php', blob);\r\n                    } catch(e){}\r\n                });\r\n\r\n                \/\/ Bot\u00e3o manual\r\n                document.getElementById('reagendarPix').addEventListener('click', function(){\r\n                    if (gatewayId) schedulePixTracking(gatewayId,'manual');\r\n                });\r\n\r\n                \/\/ Visibilidade da aba: ao voltar, se ainda pendente e n\u00e3o agendado, tenta novamente\r\n                document.addEventListener('visibilitychange', function() {\r\n                    if (document.visibilityState === 'visible' && gatewayId && !trackingScheduledFlag) {\r\n                        schedulePixTracking(gatewayId,'visibility');\r\n                    }\r\n                });\r\n            })();\r\n        });\r\n    <\/script>\r\n<\/body>\r\n<\/html>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-4fe13952 e-con-full e-flex e-con e-child\" data-id=\"4fe13952\" data-element_type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-1872b082 elementor-widget-mobile__width-initial elementor-widget elementor-widget-image\" data-id=\"1872b082\" data-element_type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"115\" height=\"40\" src=\"https:\/\/uniangola.blog\/wp-content\/uploads\/2025\/10\/SELO.webp\" class=\"attachment-large size-large wp-image-62\" alt=\"\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-27a8f7a4 elementor-widget-mobile__width-initial elementor-widget elementor-widget-heading\" data-id=\"27a8f7a4\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Garantimos uma <b>experi\u00eancia segura<\/b> para todos os nossos doadores.<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-47b3b4be e-con-full e-flex e-con e-child\" data-id=\"47b3b4be\" data-element_type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-5cb42ca8 elementor-widget elementor-widget-html\" data-id=\"5cb42ca8\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t\t<!DOCTYPE html>\r\n<html lang=\"pt-BR\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Pre-loading<\/title>\r\n    <!-- Importando a fonte Montserrat do Google Fonts -->\r\n    <link href=\"https:\/\/fonts.googleapis.com\/css2?family=Montserrat:wght@500&display=swap\" rel=\"stylesheet\">\r\n    <style>\r\n        \/* Estilos gerais *\/\r\n        body, html {\r\n            margin: 0;\r\n            padding: 0;\r\n            height: 100%;\r\n            overflow: hidden;\r\n            font-family: 'Montserrat', sans-serif; \/* Aplicando a fonte Montserrat *\/\r\n        }\r\n\r\n        \/* Pre-loading container *\/\r\n        .pre-loading {\r\n            position: fixed;\r\n            top: 0;\r\n            left: 0;\r\n            width: 100%;\r\n            height: 100%;\r\n            background: rgba(255, 255, 255, 0.92); \/* Cor branca com 80% de opacidade *\/\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            flex-direction: column;\r\n            z-index: 1000;\r\n        }\r\n\r\n        \/* \u00cdcone de carregamento *\/\r\n        .loader {\r\n            border: 4px solid #b1b1b1; \/* Borda mais fina *\/\r\n            border-top: 4px solid #000000; \/* Cor preta *\/\r\n            border-radius: 50%;\r\n            width: 35px; \/* Tamanho menor *\/\r\n            height: 35px; \/* Tamanho menor *\/\r\n            animation: spin 1s linear infinite;\r\n        }\r\n\r\n        @keyframes spin {\r\n            0% { transform: rotate(0deg); }\r\n            100% { transform: rotate(360deg); }\r\n        }\r\n\r\n        \/* Estilos da frase *\/\r\n        .title {\r\n            font-size: 21px; \/* Tamanho da fonte *\/\r\n            font-weight: 500; \/* Peso da fonte *\/\r\n            opacity: 0;\r\n            transition: opacity 0.5s ease-in-out;\r\n            margin-top: 20px; \/* Espa\u00e7amento de 15px entre o \u00edcone e o t\u00edtulo *\/\r\n        }\r\n\r\n        \/* Anima\u00e7\u00e3o de fechamento *\/\r\n        @keyframes fadeOut {\r\n            0% { opacity: 1; }\r\n            100% { opacity: 0; }\r\n        }\r\n\r\n        .fade-out {\r\n            animation: fadeOut 0.5s forwards;\r\n        }\r\n    <\/style>\r\n<\/head>\r\n<body>\r\n    <div class=\"pre-loading\">\r\n        <div class=\"loader\"><\/div>\r\n        <div class=\"title\" id=\"title\">Gerando Pix...<\/div>\r\n    <\/div>\r\n\r\n    <script>\r\n        \/\/ Fun\u00e7\u00e3o para controlar a exibi\u00e7\u00e3o da frase\r\n        function showTitle() {\r\n            const title = document.getElementById('title');\r\n            const preLoading = document.querySelector('.pre-loading');\r\n            \r\n            \/\/ Mostra o t\u00edtulo\r\n            title.style.opacity = 1;\r\n\r\n            \/\/ Oculta o t\u00edtulo ap\u00f3s 3 segundos\r\n            setTimeout(() => {\r\n                title.style.opacity = 0;\r\n                \r\n                \/\/ Fecha o pre-loading\r\n                preLoading.classList.add('fade-out');\r\n                setTimeout(() => {\r\n                    preLoading.style.display = 'none';\r\n                    document.body.style.overflow = 'auto'; \/\/ Permite rolar a p\u00e1gina novamente\r\n                }, 500); \/\/ Tempo para a anima\u00e7\u00e3o de fadeOut\r\n            }, 4500); \/\/ Tempo de exibi\u00e7\u00e3o da frase\r\n        }\r\n\r\n        \/\/ Inicia o pre-loading\r\n        showTitle();\r\n    <\/script>\r\n<\/body>\r\n<\/html>\r\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-16571b8d elementor-widget elementor-widget-html\" data-id=\"16571b8d\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t\t<script>\r\n(function() {\r\n    \/\/ Lista de par\u00e2metros UTM que voc\u00ea quer manter\r\n    const utmKeys = [\r\n        'utm_source','utm_medium','utm_campaign','utm_content','utm_term',\r\n        'src','sck','fbclid','fbc','fbp','utm_id','external_id'\r\n    ];\r\n\r\n    \/\/ Recupera UTMs do localStorage\r\n    function loadUTMs() {\r\n        try {\r\n            const utms = localStorage.getItem('utm_cache');\r\n            return utms ? JSON.parse(utms) : {};\r\n        } catch(e){ return {}; }\r\n    }\r\n\r\n    \/\/ Monta query string de UTMs\r\n    function buildUtmQueryString(utms) {\r\n        const params = [];\r\n        utmKeys.forEach(key => {\r\n            if (utms[key]) params.push(encodeURIComponent(key) + '=' + encodeURIComponent(utms[key]));\r\n        });\r\n        return params.length ? '&' + params.join('&') : '';\r\n    }\r\n\r\n    \/\/ Adiciona UTMs \u00e0 URL do checkout se n\u00e3o estiverem presentes\r\n    function ensureUTMsInCheckoutUrl() {\r\n        const utms = loadUTMs();\r\n        const url = new URL(window.location.href);\r\n        let changed = false;\r\n\r\n        \/\/ Se n\u00e3o tem utm_source, utm_campaign, etc, adiciona\r\n        utmKeys.forEach(key => {\r\n            if (utms[key] && !url.searchParams.get(key)) {\r\n                url.searchParams.append(key, utms[key]);\r\n                changed = true;\r\n            }\r\n        });\r\n\r\n        \/\/ Garante que preco fique primeiro na URL\r\n        if (url.searchParams.has('preco')) {\r\n            const preco = url.searchParams.get('preco');\r\n            url.searchParams.delete('preco');\r\n            url.search = 'preco=' + encodeURIComponent(preco) + (url.search ? '&' + url.search.slice(1) : '');\r\n        }\r\n\r\n        if (changed) {\r\n            window.history.replaceState(null, '', url.toString());\r\n        }\r\n    }\r\n\r\n    \/\/ Executa na inicializa\u00e7\u00e3o\r\n    ensureUTMsInCheckoutUrl();\r\n})();\r\n<\/script>\r\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-44d21a8 e-flex e-con-boxed e-con e-parent\" data-id=\"44d21a8\" data-element_type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-11df193 elementor-widget elementor-widget-html\" data-id=\"11df193\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t\t<div class=\"elementor-widget-container\">\r\n    <script>\r\nconst delayEmSegundosVagas = 1;\r\nconst delayEmSegundosCompras = 1;\r\nconst manterVagasVisiveis = false;\r\n\r\nconst compras = [\r\n{\r\n    nome: \"Vanessa R.\",\r\n    tempo: \"45 minutos\",\r\n    pagamento: \"pix\",\r\n},\r\n{\r\n    nome: \"Raquel Silveira\",\r\n    tempo: \"22 minutos\",\r\n    pagamento: \"pix\",\r\n},\r\n{\r\n    nome: \"Roberta Cavalcante\",\r\n    tempo: \"32 minutos\",\r\n    pagamento: \"pix\",\r\n},\r\n{\r\n    nome: \"Ana R.\",\r\n    tempo: \"12 minutos\",\r\n    pagamento: \"Pix\",\r\n},\r\n{\r\n    nome: \"Marcela F.\",\r\n    tempo: \"51 minutos\",\r\n    pagamento: \"cart\u00e3o de d\u00e9bito\",\r\n},\r\n{\r\n    nome: \"Juliana D.\",\r\n    tempo: \"37 minutos\",\r\n    pagamento: \"pix\",\r\n},\r\n]\r\n\r\n<\/script>\r\n\r\n<style>\r\n:root {\r\n--cor-de-destaque: #f00;\r\n}\r\n\r\n\r\n\r\n\r\n#views b,\r\n#vagas b {\r\ncolor: var(--cor-de-destaque);\r\n}\r\n\r\n\r\n#vagas{\r\ndisplay: none;\r\n}\r\n\r\n\r\n#views {\r\nmax-width: 800px;\r\nmargin: auto;\r\nline-height: 1.4;\r\n}\r\n\r\n#toast-compras {\r\nposition: fixed;\r\nright: 20px;\r\nbottom: 20px;\r\nz-index: 1000;\r\nbackground-color: #FFF;\r\npadding: 10px 20px;\r\ndisplay: flex;\r\nalign-items: center;\r\njustify-content: center;\r\ngap: 20px;\r\nborder-radius: 5px;\r\nbox-shadow: 1px 1px 5px #00000036;\r\ntransform: translateY(calc(100% + 40px));\r\ntransition: all .3s ease;\r\nopacity: 0\r\n}\r\n#toast-compras.show {\r\ntransform: none;\r\nopacity: 1\r\n}\r\n#toast-compras * {\r\nfont-family: \"Roboto\", sans-serif\r\n}\r\n#toast-compras svg {\r\nwidth: 40px;\r\nheight: 40px;\r\nfill: #11F849;\r\nborder: 3px solid #11F849;\r\npadding: 5px;\r\nborder-radius: 100px\r\n}\r\n#toast-compras .textos .linha-1 {\r\ndisplay: flex;\r\ngap: 20px;\r\nalign-items: center;\r\nmargin: 0 0 5px\r\n}\r\n#toast-compras .textos .linha-1 .nome {\r\nfont-size: 16px;\r\nfont-weight: 500;\r\nline-height: 16px;\r\ncolor: #1b1b1b;\r\nmargin: 0\r\n}\r\n#toast-compras .textos .linha-1 .tempo {\r\nfont-size: 14px;\r\nfont-weight: 400;\r\nline-height: 14px;\r\ncolor: #7a7a7a;\r\nmargin: 0\r\n}\r\n#toast-compras .textos .pagamento {\r\nfont-size: 16px;\r\nline-height: 1;\r\ncolor: #7a7a7a;\r\nmargin: 0\r\n}\r\n\r\n<\/style>\r\n\r\n\r\n\r\n<div id=\"toast-compras\" class=\"\">\r\n<svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 96.01 447.98 319.97\">\r\n<path d=\"M438.6 105.4C451.1 117.9 451.1 138.1 438.6 150.6L182.6 406.6C170.1 419.1 149.9 419.1 137.4 406.6L9.372 278.6C-3.124 266.1-3.124 245.9 9.372 233.4C21.87 220.9 42.13 220.9 54.63 233.4L159.1 338.7L393.4 105.4C405.9 92.88 426.1 92.88 438.6 105.4H438.6z\"><\/path>\r\n<\/svg>\r\n\r\n<div class=\"textos\">\r\n<div class=\"linha-1\">\r\n    <p class=\"nome\">Raquel Silveira<\/p>\r\n    <p class=\"tempo\">h\u00e1 22 minutos<\/p>\r\n<\/div>\r\n<p class=\"pagamento\">Doou no pix<\/p>\r\n<\/div>\r\n<\/div>\r\n\r\n\r\n\r\n<script>\r\nsetTimeout(() => {\r\nconfigurarVagas();\r\n}, delayEmSegundosVagas * 1000)\r\n\r\nsetTimeout(() => {\r\nmostrarToast();\r\n}, delayEmSegundosCompras * 1000)\r\n\r\n\r\ndocument.addEventListener('DOMContentLoaded', function(){\r\ninserirData();\r\nconfigurarViews();\r\n\r\nif(manterVagasVisiveis) exibirVagas();\r\n})\r\n\r\n\r\n\r\nfunction inserirLocalizacao() {\r\nfetch(\"https:\/\/wtfismyip.com\/json\").then(res => res.json().then((data) => {\r\n    const cidade = data.YourFuckingLocation.split(',')[0];\r\n    \r\n    document.querySelector('span#address').innerHTML = `de <b>${cidade}<\/b>`;\r\n}))\r\n}\r\n\r\nfunction exibirVagas(){\r\ndocument.querySelector('#vagas').style.display = \"block\";\r\n}\r\n\r\nfunction configurarVagas() {\r\nexibirVagas();\r\nconst vagasInterval = setInterval(() => {\r\n    const vagasElement = document.querySelector('#vagas b')\r\n    const vagas = Number(vagasElement.innerText);\r\n    \r\n    if(vagas >= 100) {\r\n        vagasElement.innerText = vagas - randomNumber(3, 8);\r\n    } else if(vagas >= 30) {\r\n        vagasElement.innerText = vagas - randomNumber(1, 3);\r\n    } else if(vagas >= 4) {\r\n        vagasElement.innerText = vagas - 1;\r\n    } else {\r\n        clearInterval(vagasInterval);\r\n    }\r\n    \r\n}, randomNumber(4, 8) * 1000);\r\n}\r\n\r\nfunction configurarViews() {\r\nconst viewsInterval = setInterval(() => {\r\n    const viewsElement = document.querySelector('#views b.qtd');\r\n    const views = Number(viewsElement.innerText);\r\n    \r\n    if(views <= 500) {\r\n        viewsElement.innerText = views + randomNumber(3, 8);\r\n    } else if(views >= 2300) {\r\n        viewsElement.innerText = views + randomNumber(-5, 5);\r\n    } else {\r\n        viewsElement.innerText = views + randomNumber(-3, 12);\r\n    }\r\n    \r\n}, 5 * 1000);\r\n}\r\n\r\nfunction mostrarToast() {\r\nconfigurarToast()\r\ndocument.querySelector('#toast-compras').classList.add('show');\r\n\r\nsetTimeout(() => {\r\n    document.querySelector('#toast-compras').classList.remove('show');\r\n    \r\n    setTimeout(() => {\r\n        mostrarToast();\r\n    }, randomNumber(5, 10) * 1000)\r\n}, 2500);\r\n}\r\n\r\nfunction configurarToast() {\r\ndocument.querySelector('#toast-compras .nome').innerText = compras[0].nome;\r\ndocument.querySelector('#toast-compras .tempo').innerText = `h\u00e1 ${compras[0].tempo}`;\r\ndocument.querySelector('#toast-compras .pagamento').innerText = `Doou no ${compras[0].pagamento}`;\r\n\r\ncompras.push(compras.shift());\r\n}\r\n\r\nfunction randomNumber(min, max) {\r\nmin = Math.ceil(min);\r\nmax = Math.floor(max);\r\nreturn Math.floor(Math.random() * (max - min + 1)) + min;\r\n}\r\n\r\n\r\nfunction inserirData() {\r\nconst data = new Date().toLocaleDateString();\r\ndocument.querySelector('#views b.date').innerText = data;\r\n}\r\n\r\n<\/script>\t\t<\/div>\r\n\r\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-170090c3 e-flex e-con-boxed e-con e-parent\" data-id=\"170090c3\" data-element_type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-407cd178 elementor-widget-mobile__width-initial elementor-widget__width-initial elementor-widget elementor-widget-image\" data-id=\"407cd178\" data-element_type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"200\" height=\"86\" src=\"https:\/\/uniangola.blog\/wp-content\/uploads\/2025\/10\/Uni-Ang.png\" class=\"attachment-large size-large wp-image-14\" alt=\"\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-64d1e544 e-flex e-con-boxed e-con e-parent\" data-id=\"64d1e544\" data-element_type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-65899728 elementor-widget elementor-widget-heading\" data-id=