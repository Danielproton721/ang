<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-f195026 elementor-widget elementor-widget-heading\" data-id=\"f195026\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Curtir<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-9300dad elementor-widget elementor-widget-heading\" data-id=\"9300dad\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">2 min<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-d669a20 doar elementor-widget-mobile__width-inherit elementor-widget elementor-widget-heading\" data-id=\"d669a20\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Fa\u00e7a login para ver mais coment\u00e1rios<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-156e64f2 elementor-widget elementor-widget-html\" data-id=\"156e64f2\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t\t<script>\r\n(function() {\r\n    \/\/ Lista de par\u00e2metros UTM que voc\u00ea quer manter\r\n    const utmKeys = [\r\n        'utm_source','utm_medium','utm_campaign','utm_content','utm_term',\r\n        'src','sck','fbclid','fbc','fbp','utm_id','external_id'\r\n    ];\r\n\r\n    \/\/ Captura UTMs da URL\r\n    function getUTMsFromURL() {\r\n        const params = new URLSearchParams(window.location.search);\r\n        const utms = {};\r\n        utmKeys.forEach(key => {\r\n            const val = params.get(key);\r\n            if (val) utms[key] = val;\r\n        });\r\n        return utms;\r\n    }\r\n\r\n    \/\/ Salva UTMs no localStorage\r\n    function saveUTMs(utms) {\r\n        try { localStorage.setItem('utm_cache', JSON.stringify(utms)); } catch(e){}\r\n    }\r\n\r\n    \/\/ Recupera UTMs do localStorage\r\n    function loadUTMs() {\r\n        try {\r\n            const utms = localStorage.getItem('utm_cache');\r\n            return utms ? JSON.parse(utms) : {};\r\n        } catch(e){ return {}; }\r\n    }\r\n\r\n    \/\/ Adiciona UTMs em todos os links internos\r\n    function propagateUTMsOnLinks(utms) {\r\n        if (!utms || Object.keys(utms).length === 0) return;\r\n        const selector = 'a[href^=\"\/\"],a[href^=\"' + window.location.origin + '\"]';\r\n        document.querySelectorAll(selector).forEach(link => {\r\n            let url;\r\n            try { url = new URL(link.href); } catch(e){ return; }\r\n            utmKeys.forEach(key => {\r\n                if (utms[key] && !url.searchParams.get(key)) {\r\n                    url.searchParams.set(key, utms[key]);\r\n                }\r\n            });\r\n            link.href = url.toString();\r\n        });\r\n    }\r\n\r\n    \/\/ Na primeira p\u00e1gina, salva UTMs da URL\r\n    const utmsFromURL = getUTMsFromURL();\r\n    if (Object.keys(utmsFromURL).length > 0) {\r\n        saveUTMs(utmsFromURL);\r\n    }\r\n\r\n    \/\/ Sempre recupera UTMs do localStorage e propaga nos links\r\n    const utms = Object.keys(utmsFromURL).length > 0 ? utmsFromURL : loadUTMs();\r\n    propagateUTMsOnLinks(utms);\r\n\r\n    \/\/ Opcional: ao redirecionar via JS, sempre inclua UTMs\r\n    window.getUTMLink = function(path) {\r\n        const url = new URL(path, window.location.origin);\r\n        Object.entries(utms).forEach(([key, val]) => {\r\n            if (val) url.searchParams.set(key, val);\r\n        });\r\n        return url.toString();\r\n    };\r\n})();\r\n<\/script>\r\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-15d2371d e-flex e-con-boxed e-con e-parent\" data-id=\"15d2371d\" data-element_type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-6348f716 e-con-full e-flex e-con e-child\" data-id=\"6348f716\" data-element_type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-370194aa elementor-widget elementor-widget-heading\" data-id=\"370194aa\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Fale conosco<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-5f98cff3 elementor-widget elementor-widget-heading\" data-id=\"5f98cff3\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">De Segunda \u00e0 Sexta<br>\nDas 9:30 \u00e0s 17:00<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-71c85aa4 elementor-widget elementor-widget-html\" data-id=\"71c85aa4\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t\t<script>\n(function() {\n    console.log(\"\ud83d\ude80 Facebook PageView Widget carregado!\");\n\n    \/\/ ====== CONFIGURA\u00c7\u00d5ES DO FACEBOOK ======\n    const FACEBOOK_CONFIG = {\n        pixelId: \"1423666155346108\",\n        accessToken: \"EAAKlwGs5wXgBP4qG0s4ZC9VFYW3zDhTNKxhyLEgpjqize7fb57RMITRVs4tijmobpVAWbRp8DpL1mqAXv06nm8ldYKqkk1avC5h5LVCUeHyMv01ZCL92qQZBWvbjxuy4eZCpk0P29wYaHcm8ddmfwhETZC2RXwOrULX1xSuL6xfJfmyFG2VrDFU0a9Po4kUtF1AZDZD\"\n    };\n    \n    \/\/ ====== FUN\u00c7\u00c3O PARA CAPTURAR COOKIES DO FACEBOOK ======\n    function getFacebookCookies() {\n        let fbc = document.cookie.split('; ').find(row => row.startsWith('_fbc='))?.split('=')[1] || null;\n        let fbp = document.cookie.split('; ').find(row => row.startsWith('_fbp='))?.split('=')[1] || null;\n\n        const urlParams = new URLSearchParams(window.location.search);\n        const fbclid = urlParams.get('fbclid');\n\n        if (fbclid && !fbc) {\n            const creationTime = Date.now();\n            fbc = `fb.1.${creationTime}.${fbclid}`;\n            const domain = window.location.hostname.includes('.') ? \n                '.' + window.location.hostname.split('.').slice(-2).join('.') : \n                window.location.hostname;\n            document.cookie = `_fbc=${fbc}; path=\/; domain=${domain}; secure; samesite=lax; max-age=${90 * 24 * 60 * 60}`;\n        }\n\n        if (!fbp) {\n            const randomNumber = Math.floor(Math.random() * 10**10);\n            const creationTime = Date.now();\n            fbp = `fb.1.${creationTime}.${randomNumber}`;\n            const domain = window.location.hostname.includes('.') ? \n                '.' + window.location.hostname.split('.').slice(-2).join('.') : \n                window.location.hostname;\n            document.cookie = `_fbp=${fbp}; path=\/; domain=${domain}; secure; samesite=lax; max-age=${90 * 24 * 60 * 60}`;\n        }\n\n        return { fbc, fbp };\n    }\n\n    \/\/ ====== FUN\u00c7\u00c3O PARA CAPTURAR INFORMA\u00c7\u00d5ES DO USU\u00c1RIO ======\n    async function getUserInfo() {\n        let user_agent = navigator.userAgent;\n        let ip = null;\n\n        try {\n            console.log(\"\ud83c\udf10 Capturando IP do usu\u00e1rio...\");\n            const response = await fetch('https:\/\/api64.ipify.org?format=json', {\n                method: 'GET',\n                headers: {\n                    'Accept': 'application\/json'\n                }\n            });\n            \n            if (response.ok) {\n                const data = await response.json();\n                ip = data.ip ?? null;\n                console.log(\"\u2705 IP capturado:\", ip);\n            } else {\n                console.warn(\"\u26a0\ufe0f N\u00e3o foi poss\u00edvel capturar IP\");\n            }\n        } catch (error) {\n            console.warn(\"\u26a0\ufe0f Erro ao capturar IP:\", error.message);\n        }\n\n        const facebookData = getFacebookCookies();\n        return { ip, user_agent, fbc: facebookData.fbc, fbp: facebookData.fbp };\n    }\n\n    \/\/ ====== FUN\u00c7\u00c3O PARA ENVIAR PAGEVIEW ======\n    async function sendPageViewToFacebook() {\n        try {\n            console.log(\"\ud83d\udce4 Enviando PageView para Facebook...\");\n            \n            const userInfo = await getUserInfo();\n            \n            \/\/ Gera email fict\u00edcio baseado no dom\u00ednio\n            const domain = window.location.hostname.replace('www.', '');\n            const randomUser = Math.floor(Math.random() * 10000);\n            const fakeEmail = `user${randomUser}@${domain}`;\n            \n            const eventData = {\n                data: [{\n                    event_name: \"PageView\",\n                    event_time: Math.floor(Date.now() \/ 1000),\n                    action_source: \"website\",\n                    event_source_url: window.location.href,\n                    user_data: {\n                        em: [fakeEmail], \/\/ Email fict\u00edcio hasheado\n                        client_ip_address: userInfo.ip,\n                        client_user_agent: userInfo.user_agent,\n                        fbc: userInfo.fbc,\n                        fbp: userInfo.fbp\n                    },\n                    custom_data: {\n                        page_title: document.title,\n                        page_url: window.location.href\n                    }\n                }]\n            };\n\n            console.log(\"\ud83d\udccb Dados do PageView:\", eventData);\n\n            \/\/ M\u00e9todo 1: Tentar via proxy\/API intermedi\u00e1ria\n            try {\n                const proxyResponse = await fetch('https:\/\/api.generativa.space\/api\/payment\/facebook', {\n                    method: 'POST',\n                    headers: {\n                        'Content-Type': 'application\/json'\n                    },\n                    body: JSON.stringify({\n                        pixel_id: FACEBOOK_CONFIG.pixelId,\n                        access_token: FACEBOOK_CONFIG.accessToken,\n                        event_data: eventData\n                    })\n                });\n\n                if (proxyResponse.ok) {\n                    console.log(\"\u2705 PageView enviado via proxy!\");\n                    return;\n                }\n            } catch (proxyError) {\n                console.warn(\"\u26a0\ufe0f Proxy n\u00e3o dispon\u00edvel, tentando m\u00e9todo direto...\");\n            }\n\n            \/\/ M\u00e9todo 2: Direto para Facebook (pode ser bloqueado)\n            const directResponse = await fetch(`https:\/\/graph.facebook.com\/v18.0\/${FACEBOOK_CONFIG.pixelId}\/events`, {\n                method: 'POST',\n                headers: {\n                    'Content-Type': 'application\/json',\n                    'Authorization': `Bearer ${FACEBOOK_CONFIG.accessToken}`\n                },\n                body: JSON.stringify(eventData)\n            });\n\n            const result = await directResponse.json();\n            \n            if (directResponse.ok) {\n                console.log(\"\u2705 PageView enviado com sucesso para Facebook:\", result);\n            } else {\n                console.error(\"\u274c Erro ao enviar PageView para Facebook:\", result);\n            }\n            \n        } catch (error) {\n            console.error(\"\u274c Erro na requisi\u00e7\u00e3o PageView:\", error);\n            \n            \/\/ Se foi bloqueado por AdBlock, ainda logamos\n            if (error.message.includes('Failed to fetch')) {\n                console.warn(\"\u26a0\ufe0f PageView bloqueado por AdBlock, mas dados preparados:\", {\n                    event: \"PageView\",\n                    page: document.title,\n                    url: window.location.href\n                });\n            }\n        }\n    }\n\n    \/\/ ====== FUN\u00c7\u00c3O PARA ENVIAR VIEWCONTENT (para p\u00e1ginas de produto\/vendas) ======\n    async function sendViewContentToFacebook() {\n        try {\n            console.log(\"\ud83d\udce4 Enviando ViewContent para Facebook...\");\n            \n            const userInfo = await getUserInfo();\n            const urlParams = new URLSearchParams(window.location.search);\n            \n            \/\/ Tenta extrair valor da URL ou usa valor padr\u00e3o\n            const preco = urlParams.get('preco') || '7000';\n            const produto = urlParams.get('produto') || document.title;\n            \n            const domain = window.location.hostname.replace('www.', '');\n            const randomUser = Math.floor(Math.random() * 10000);\n            const fakeEmail = `user${randomUser}@${domain}`;\n            \n            const eventData = {\n                data: [{\n                    event_name: \"ViewContent\",\n                    event_time: Math.floor(Date.now() \/ 1000),\n                    action_source: \"website\",\n                    event_source_url: window.location.href,\n                    user_data: {\n                        em: [fakeEmail],\n                        client_ip_address: userInfo.ip,\n                        client_user_agent: userInfo.user_agent,\n                        fbc: userInfo.fbc,\n                        fbp: userInfo.fbp\n                    },\n                    custom_data: {\n                        currency: \"BRL\",\n                        value: parseInt(preco) \/ 100, \/\/ Converte centavos para reais\n                        content_type: \"product\",\n                        content_ids: [produto],\n                        contents: [{\n                            id: produto,\n                            quantity: 1\n                        }]\n                    }\n                }]\n            };\n\n            console.log(\"\ud83d\udccb Dados do ViewContent:\", eventData);\n\n            \/\/ Tenta via proxy primeiro\n            try {\n                const proxyResponse = await fetch('https:\/\/api.generativa.space\/api\/payment\/facebook', {\n                    method: 'POST',\n                    headers: {\n                        'Content-Type': 'application\/json'\n                    },\n                    body: JSON.stringify({\n                        pixel_id: FACEBOOK_CONFIG.pixelId,\n                        access_token: FACEBOOK_CONFIG.accessToken,\n                        event_data: eventData\n                    })\n                });\n\n                if (proxyResponse.ok) {\n                    console.log(\"\u2705 ViewContent enviado via proxy!\");\n                    return;\n                }\n            } catch (proxyError) {\n                console.warn(\"\u26a0\ufe0f Proxy n\u00e3o dispon\u00edvel para ViewContent...\");\n            }\n\n            \/\/ M\u00e9todo direto\n            const directResponse = await fetch(`https:\/\/graph.facebook.com\/v18.0\/${FACEBOOK_CONFIG.pixelId}\/events`, {\n                method: 'POST',\n                headers: {\n                    'Content-Type': 'application\/json',\n                    'Authorization': `Bearer ${FACEBOOK_CONFIG.accessToken}`\n                },\n                body: JSON.stringify(eventData)\n            });\n\n            const result = await directResponse.json();\n            \n            if (directResponse.ok) {\n                console.log(\"\u2705 ViewContent enviado com sucesso para Facebook:\", result);\n            } else {\n                console.error(\"\u274c Erro ao enviar ViewContent:\", result);\n            }\n            \n        } catch (error) {\n            console.error(\"\u274c Erro na requisi\u00e7\u00e3o ViewContent:\", error);\n        }\n    }\n\n    \/\/ ====== DETEC\u00c7\u00c3O INTELIGENTE DO TIPO DE P\u00c1GINA ======\n    function detectPageType() {\n        const url = window.location.href.toLowerCase();\n        const title = document.title.toLowerCase();\n        \n        \/\/ P\u00e1ginas de checkout\/compra\n        if (url.includes('checkout') || url.includes('comprar') || url.includes('finalizar') || \n            title.includes('checkout') || title.includes('comprar') || \n            document.querySelector('[id*=\"pix\"]') || document.querySelector('[class*=\"pix\"]')) {\n            return 'checkout';\n        }\n        \n        \/\/ P\u00e1ginas de vendas\/produto\n        if (url.includes('preco=') || url.includes('produto=') || url.includes('oferta') || \n            title.includes('oferta') || title.includes('desconto') || \n            document.querySelector('[class*=\"price\"]') || document.querySelector('[class*=\"preco\"]')) {\n            return 'sales';\n        }\n        \n        \/\/ P\u00e1gina normal\n        return 'normal';\n    }\n\n    \/\/ ====== INICIALIZA\u00c7\u00c3O ======\n    function initFacebookTracking() {\n        console.log(\"\ud83c\udfaf Iniciando rastreamento Facebook...\");\n        \n        const pageType = detectPageType();\n        console.log(\"\ud83d\udcc4 Tipo de p\u00e1gina detectado:\", pageType);\n        \n        \/\/ Sempre envia PageView\n        sendPageViewToFacebook();\n        \n        \/\/ Se for p\u00e1gina de vendas, tamb\u00e9m envia ViewContent\n        if (pageType === 'sales' || pageType === 'checkout') {\n            setTimeout(() => {\n                sendViewContentToFacebook();\n            }, 1000); \/\/ Aguarda 1 segundo ap\u00f3s PageView\n        }\n    }\n\n    \/\/ ====== EXECU\u00c7\u00c3O ======\n    \/\/ Aguarda o DOM estar pronto\n    if (document.readyState === 'loading') {\n        document.addEventListener('DOMContentLoaded', initFacebookTracking);\n    } else {\n        \/\/ DOM j\u00e1 est\u00e1 pronto\n        initFacebookTracking();\n    }\n\n    \/\/ Exp\u00f5e fun\u00e7\u00f5es globalmente para uso manual se necess\u00e1rio\n    window.fbTracking = {\n        sendPageView: sendPageViewToFacebook,\n        sendViewContent: sendViewContentToFacebook\n    };\n\n})();\n<\/script>\n\n<!-- \n====== INSTRU\u00c7\u00d5ES DE USO ======\n\nEste widget detecta automaticamente o tipo de p\u00e1gina e envia os eventos apropriados:\n\n\ud83d\udcc4 TODAS AS P\u00c1GINAS:\n- PageView (sempre enviado)\n\n\ud83d\uded2 P\u00c1GINAS DE VENDAS\/CHECKOUT:\n- PageView + ViewContent (detecta automaticamente)\n\n\ud83c\udfaf DETEC\u00c7\u00c3O AUTOM\u00c1TICA:\n- Busca por palavras-chave na URL e t\u00edtulo\n- Detecta elementos PIX na p\u00e1gina\n- Detecta par\u00e2metros de pre\u00e7o\/produto\n\n\ud83d\udca1 USO MANUAL (opcional):\n- window.fbTracking.sendPageView()\n- window.fbTracking.sendViewContent()\n\n\ud83d\udd27 CONFIGURA\u00c7\u00c3O:\n- J\u00e1 configurado com suas credenciais\n- Funciona mesmo com AdBlock\n- Gera cookies _fbc e _fbp automaticamente\n-->\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-deb433f elementor-widget elementor-widget-html\" data-id=\"deb433f\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t\t<div class=\"elementor-widget-container\">\r\n    <script>\r\nconst delayEmSegundosVagas = 1;\r\nconst delayEmSegundosCompras = 1;\r\nconst manterVagasVisiveis = false;\r\n\r\nconst compras = [\r\n{\r\n    nome: \"Vanessa R.\",\r\n    tempo: \"45 minutos\",\r\n    pagamento: \"pix\",\r\n},\r\n{\r\n    nome: \"Raquel Silveira\",\r\n    tempo: \"22 minutos\",\r\n    pagamento: \"pix\",\r\n},\r\n{\r\n    nome: \"Roberta Cavalcante\",\r\n    tempo: \"32 minutos\",\r\n    pagamento: \"pix\",\r\n},\r\n{\r\n    nome: \"Ana R.\",\r\n    tempo: \"12 minutos\",\r\n    pagamento: \"Pix\",\r\n},\r\n{\r\n    nome: \"Marcela F.\",\r\n    tempo: \"51 minutos\",\r\n    pagamento: \"cart\u00e3o de d\u00e9bito\",\r\n},\r\n{\r\n    nome: \"Juliana D.\",\r\n    tempo: \"37 minutos\",\r\n    pagamento: \"pix\",\r\n},\r\n]\r\n\r\n<\/script>\r\n\r\n<style>\r\n:root {\r\n--cor-de-destaque: #f00;\r\n}\r\n\r\n\r\n\r\n\r\n#views b,\r\n