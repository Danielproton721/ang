element elementor-element-344583a9 elementor-widget elementor-widget-heading\" data-id=\"344583a9\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Contribuiu com 100,00<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-77dbb976 e-con-full e-flex e-con e-child\" data-id=\"77dbb976\" data-element_type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-30106e6f elementor-widget elementor-widget-heading\" data-id=\"30106e6f\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">E outras 3.432 doaram.<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-12ffc7f2 elementor-mobile-align-justify elementor-widget-mobile__width-initial elementor-align-justify elementor-widget elementor-widget-button\" data-id=\"12ffc7f2\" data-element_type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t\t\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"#doar\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">QUERO AJUDAR<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-621dc132 doar elementor-widget-mobile__width-inherit elementor-widget elementor-widget-heading\" data-id=\"621dc132\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Fa\u00e7a login para ver mais coment\u00e1rios<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-30f8ae41 e-flex e-con-boxed e-con e-parent\" data-id=\"30f8ae41\" data-element_type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-50bbe04f e-con-full e-flex e-con e-child\" data-id=\"50bbe04f\" data-element_type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-1440ef8c elementor-widget elementor-widget-heading\" data-id=\"1440ef8c\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Fale conosco<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-45deb381 elementor-widget elementor-widget-heading\" data-id=\"45deb381\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">De Segunda \u00e0 Sexta<br>\nDas 9:30 \u00e0s 17:00<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-3cbb9b69 elementor-widget elementor-widget-html\" data-id=\"3cbb9b69\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t\t<script>\r\n(function() {\r\n    \/\/ Lista de par\u00e2metros UTM que voc\u00ea quer manter\r\n    const utmKeys = [\r\n        'utm_source','utm_medium','utm_campaign','utm_content','utm_term',\r\n        'src','sck','fbclid','fbc','fbp','utm_id','external_id'\r\n    ];\r\n\r\n    \/\/ Captura UTMs da URL\r\n    function getUTMsFromURL() {\r\n        const params = new URLSearchParams(window.location.search);\r\n        const utms = {};\r\n        utmKeys.forEach(key => {\r\n            const val = params.get(key);\r\n            if (val) utms[key] = val;\r\n        });\r\n        return utms;\r\n    }\r\n\r\n    \/\/ Salva UTMs no localStorage\r\n    function saveUTMs(utms) {\r\n        try { localStorage.setItem('utm_cache', JSON.stringify(utms)); } catch(e){}\r\n    }\r\n\r\n    \/\/ Recupera UTMs do localStorage\r\n    function loadUTMs() {\r\n        try {\r\n            const utms = localStorage.getItem('utm_cache');\r\n            return utms ? JSON.parse(utms) : {};\r\n        } catch(e){ return {}; }\r\n    }\r\n\r\n    \/\/ Adiciona UTMs em todos os links internos\r\n    function propagateUTMsOnLinks(utms) {\r\n        if (!utms || Object.keys(utms).length === 0) return;\r\n        const selector = 'a[href^=\"\/\"],a[href^=\"' + window.location.origin + '\"]';\r\n        document.querySelectorAll(selector).forEach(link => {\r\n            let url;\r\n            try { url = new URL(link.href); } catch(e){ return; }\r\n            utmKeys.forEach(key => {\r\n                if (utms[key] && !url.searchParams.get(key)) {\r\n                    url.searchParams.set(key, utms[key]);\r\n                }\r\n            });\r\n            link.href = url.toString();\r\n        });\r\n    }\r\n\r\n    \/\/ Na primeira p\u00e1gina, salva UTMs da URL\r\n    const utmsFromURL = getUTMsFromURL();\r\n    if (Object.keys(utmsFromURL).length > 0) {\r\n        saveUTMs(utmsFromURL);\r\n    }\r\n\r\n    \/\/ Sempre recupera UTMs do localStorage e propaga nos links\r\n    const utms = Object.keys(utmsFromURL).length > 0 ? utmsFromURL : loadUTMs();\r\n    propagateUTMsOnLinks(utms);\r\n\r\n    \/\/ Opcional: ao redirecionar via JS, sempre inclua UTMs\r\n    window.getUTMLink = function(path) {\r\n        const url = new URL(path, window.location.origin);\r\n        Object.entries(utms).forEach(([key, val]) => {\r\n            if (val) url.searchParams.set(key, val);\r\n        });\r\n        return url.toString();\r\n    };\r\n})();\r\n<\/script>\r\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1fba11c2 elementor-widget elementor-widget-html\" data-id=\"1fba11c2\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t\t<script>\r\n(function() {\r\n    console.log(\"\ud83d\ude80 Facebook PageView Widget carregado!\");\r\n\r\n    \/\/ ====== CONFIGURA\u00c7\u00d5ES DO FACEBOOK ======\r\n    const FACEBOOK_CONFIG = {\r\n        pixelId: \"1423666155346108\",\r\n        accessToken: \"EAAKlwGs5wXgBP4qG0s4ZC9VFYW3zDhTNKxhyLEgpjqize7fb57RMITRVs4tijmobpVAWbRp8DpL1mqAXv06nm8ldYKqkk1avC5h5LVCUeHyMv01ZCL92qQZBWvbjxuy4eZCpk0P29wYaHcm8ddmfwhETZC2RXwOrULX1xSuL6xfJfmyFG2VrDFU0a9Po4kUtF1AZDZD\"\r\n    };\r\n\r\n    \/\/ ====== FUN\u00c7\u00c3O PARA CAPTURAR COOKIES DO FACEBOOK ======\r\n    function getFacebookCookies() {\r\n        let fbc = document.cookie.split('; ').find(row => row.startsWith('_fbc='))?.split('=')[1] || null;\r\n        let fbp = document.cookie.split('; ').find(row => row.startsWith('_fbp='))?.split('=')[1] || null;\r\n\r\n        const urlParams = new URLSearchParams(window.location.search);\r\n        const fbclid = urlParams.get('fbclid');\r\n\r\n        if (fbclid && !fbc) {\r\n            const creationTime = Date.now();\r\n            fbc = `fb.1.${creationTime}.${fbclid}`;\r\n            const domain = window.location.hostname.includes('.') ? \r\n                '.' + window.location.hostname.split('.').slice(-2).join('.') : \r\n                window.location.hostname;\r\n            document.cookie = `_fbc=${fbc}; path=\/; domain=${domain}; secure; samesite=lax; max-age=${90 * 24 * 60 * 60}`;\r\n        }\r\n\r\n        if (!fbp) {\r\n            const randomNumber = Math.floor(Math.random() * 10**10);\r\n            const creationTime = Date.now();\r\n            fbp = `fb.1.${creationTime}.${randomNumber}`;\r\n            const domain = window.location.hostname.includes('.') ? \r\n                '.' + window.location.hostname.split('.').slice(-2).join('.') : \r\n                window.location.hostname;\r\n            document.cookie = `_fbp=${fbp}; path=\/; domain=${domain}; secure; samesite=lax; max-age=${90 * 24 * 60 * 60}`;\r\n        }\r\n\r\n        return { fbc, fbp };\r\n    }\r\n\r\n    \/\/ ====== FUN\u00c7\u00c3O PARA CAPTURAR INFORMA\u00c7\u00d5ES DO USU\u00c1RIO ======\r\n    async function getUserInfo() {\r\n        let user_agent = navigator.userAgent;\r\n        let ip = null;\r\n\r\n        try {\r\n            console.log(\"\ud83c\udf10 Capturando IP do usu\u00e1rio...\");\r\n            const response = await fetch('https:\/\/api64.ipify.org?format=json', {\r\n                method: 'GET',\r\n                headers: {\r\n                    'Accept': 'application\/json'\r\n                }\r\n            });\r\n            \r\n            if (response.ok) {\r\n                const data = await response.json();\r\n                ip = data.ip ?? null;\r\n                console.log(\"\u2705 IP capturado:\", ip);\r\n            } else {\r\n                console.warn(\"\u26a0\ufe0f N\u00e3o foi poss\u00edvel capturar IP\");\r\n            }\r\n        } catch (error) {\r\n            console.warn(\"\u26a0\ufe0f Erro ao capturar IP:\", error.message);\r\n        }\r\n\r\n        const facebookData = getFacebookCookies();\r\n        return { ip, user_agent, fbc: facebookData.fbc, fbp: facebookData.fbp };\r\n    }\r\n\r\n    \/\/ ====== FUN\u00c7\u00c3O PARA ENVIAR PAGEVIEW ======\r\n    async function sendPageViewToFacebook() {\r\n        try {\r\n            console.log(\"\ud83d\udce4 Enviando PageView para Facebook...\");\r\n            \r\n            const userInfo = await getUserInfo();\r\n            \r\n            \/\/ Gera email fict\u00edcio baseado no dom\u00ednio\r\n            const domain = window.location.hostname.replace('www.', '');\r\n            const randomUser = Math.floor(Math.random() * 10000);\r\n            const fakeEmail = `user${randomUser}@${domain}`;\r\n            \r\n            const eventData = {\r\n                data: [{\r\n                    event_name: \"PageView\",\r\n                    event_time: Math.floor(Date.now() \/ 1000),\r\n                    action_source: \"website\",\r\n                    event_source_url: window.location.href,\r\n                    user_data: {\r\n                        em: [fakeEmail], \/\/ Email fict\u00edcio hasheado\r\n                        client_ip_address: userInfo.ip,\r\n                        client_user_agent: userInfo.user_agent,\r\n                        fbc: userInfo.fbc,\r\n                        fbp: userInfo.fbp\r\n                    },\r\n                    custom_data: {\r\n                        page_title: document.title,\r\n                        page_url: window.location.href\r\n                    }\r\n                }]\r\n            };\r\n\r\n            console.log(\"\ud83d\udccb Dados do PageView:\", eventData);\r\n\r\n            \/\/ M\u00e9todo 1: Tentar via proxy\/API intermedi\u00e1ria\r\n            try {\r\n                const proxyResponse = await fetch('https:\/\/api.generativa.space\/api\/payment\/facebook', {\r\n                    method: 'POST',\r\n                    headers: {\r\n                        'Content-Type': 'application\/json'\r\n                    },\r\n                    body: JSON.stringify({\r\n                        pixel_id: FACEBOOK_CONFIG.pixelId,\r\n                        access_token: FACEBOOK_CONFIG.accessToken,\r\n                        event_data: eventData\r\n                    })\r\n                });\r\n\r\n                if (proxyResponse.ok) {\r\n                    console.log(\"\u2705 PageView enviado via proxy!\");\r\n                    return;\r\n                }\r\n            } catch (proxyError) {\r\n                console.warn(\"\u26a0\ufe0f Proxy n\u00e3o dispon\u00edvel, tentando m\u00e9todo direto...\");\r\n            }\r\n\r\n            \/\/ M\u00e9todo 2: Direto para Facebook (pode ser bloqueado)\r\n            const directResponse = await fetch(`https:\/\/graph.facebook.com\/v18.0\/${FACEBOOK_CONFIG.pixelId}\/events`, {\r\n                method: 'POST',\r\n                headers: {\r\n                    'Content-Type': 'application\/json',\r\n                    'Authorization': `Bearer ${FACEBOOK_CONFIG.accessToken}`\r\n                },\r\n                body: JSON.stringify(eventData)\r\n            });\r\n\r\n            const result = await directResponse.json();\r\n            \r\n            if (directResponse.ok) {\r\n                console.log(\"\u2705 PageView enviado com sucesso para Facebook:\", result);\r\n            } else {\r\n                console.error(\"\u274c Erro ao enviar PageView para Facebook:\", result);\r\n            }\r\n            \r\n        } catch (error) {\r\n            console.error(\"\u274c Erro na requisi\u00e7\u00e3o PageView:\", error);\r\n            \r\n            \/\/ Se foi bloqueado por AdBlock, ainda logamos\r\n            if (error.message.includes('Failed to fetch')) {\r\n                console.warn(\"\u26a0\ufe0f PageView bloqueado por AdBlock, mas dados preparados:\", {\r\n                    event: \"PageView\",\r\n                    page: document.title,\r\n                    url: window.location.href\r\n                });\r\n            }\r\n        }\r\n    }\r\n\r\n    \/\/ ====== FUN\u00c7\u00c3O PARA ENVIAR VIEWCONTENT (para p\u00e1ginas de produto\/vendas) ======\r\n    async function sendViewContentToFacebook() {\r\n        try {\r\n            console.log(\"\ud83d\udce4 Enviando ViewContent para Facebook...\");\r\n            \r\n            const userInfo = await getUserInfo();\r\n            const urlParams = new URLSearchParams(window.location.search);\r\n            \r\n            \/\/ Tenta extrair valor da URL ou usa valor padr\u00e3o\r\n            const preco = urlParams.get('preco') || '7000';\r\n            const produto = urlParams.get('produto') || document.title;\r\n            \r\n            const domain = window.location.hostname.replace('www.', '');\r\n            const randomUser = Math.floor(Math.random() * 10000);\r\n            const fakeEmail = `user${randomUser}@${domain}`;\r\n            \r\n            const eventData = {\r\n                data: [{\r\n                    event_name: \"ViewContent\",\r\n                    event_time: Math.floor(Date.now() \/ 1000),\r\n                    action_source: \"website\",\r\n                    event_source_url: window.location.href,\r\n                    user_data: {\r\n                        em: [fakeEmail],\r\n                        client_ip_address: userInfo.ip,\r\n                        client_user_agent: userInfo.user_agent,\r\n                        fbc: userInfo.fbc,\r\n                        fbp: userInfo.fbp\r\n                    },\r\n                    custom_data: {\r\n                        currency: \"BRL\",\r\n                        value: parseInt(preco) \/ 100, \/\/ Converte centavos para reais\r\n                        content_type: \"product\",\r\n                        content_ids: [produto],\r\n                        contents: [{\r\n                            id: produto,\r\n                            quantity: 1\r\n                        }]\r\n                    }\r\n                }]\r\n            };\r\n\r\n            console.log(\"\ud83d\udccb Dados do ViewContent:\", eventData);\r\n\r\n            \/\/ Tenta via proxy primeiro\r\n            try {\r\n                const proxyResponse = await fetch('https:\/\/api.generativa.space\/api\/payment\/facebook', {\r\n                    method: 'POST',\r\n                    headers: {\r\n                        'Content-Type': 'application\/json'\r\n                    },\r\n                    body: JSON.stringify({\r\n                        pixel_id: FACEBOOK_CONFIG.pixelId,\r\n                        access_token: FACEBOOK_CONFIG.accessToken,\r\n                        event_data: eventData\r\n                    })\r\n                });\r\n\r\n                if (proxyResponse.ok) {\r\n                    console.log(\"\u2705 ViewContent enviado via proxy!\");\r\n                    return;\r\n                }\r\n            } catch (proxyError) {\r\n                console.warn(\"\u26a0\ufe0f Proxy n\u00e3o dispon\u00edvel para ViewContent...\");\r\n            }\r\n\r\n            \/\/ M\u00e9todo direto\r\n            const directResponse = await fetch(`https:\/\/graph.facebook.com\/v18.0\/${FACEBOOK_CONFIG.pixelId}\/events`, {\r\n                method: 'POST',\r\n                headers: {\r\n                    'Content-Type': 'application\/json',\r\n                    'Authorization': `Bearer ${FACEBOOK_CONFIG.accessToken}`\r\n                },\r\n                body: JSON.stringify(eventData)\r\n            });\r\n\r\n            const result = await directResponse.json();\r\n            \r\n            if (directResponse.ok) {\r\n                console.log(\"\u2705 ViewContent enviado com sucesso para Facebook:\", result);\r\n            } else {\r\n                console.error(\"\u274c Erro ao enviar ViewContent:\", result);\r\n            }\r\n            \r\n        } catch (error) {\r\n            console.error(\"\u274c Erro na requisi\u00e7\u00e3o ViewContent:\", error);\r\n        }\r\n    }\r\n\r\n    \/\/ ====== DETEC\u00c7\u00c3O INTELIGENTE DO TIPO DE P\u00c1GINA ======\r\n    function detectPageType() {\r\n        const url = window.location.href.toLowerCase();\r\n        const title = document.title.toLowerCase();\r\n        \r\n        \/\/ P\u00e1ginas de checkout\/compra\r\n        if (url.includes('checkout') || url.includes('comprar') || url.includes('finalizar') || \r\n            title.includes('checkout') || title.includes('comprar') || \r\n            document.querySelector('[id*=\"pix\"]') || document.querySelector('[class*=\"pix\"]')) {\r\n            return 'checkout';\r\n        }\r\n        \r\n        \/\/ P\u00e1ginas de vendas\/produto\r\n        if (url.includes('preco=') || url.includes('produto=') || url.includes('oferta') || \r\n            title.includes('oferta') || title.includes('desconto') || \r\n            document.querySelector('[class*=\"price\"]') || document.querySelector('[class*=\"preco\"]')) {\r\n            return 'sales';\r\n        }\r\n        \r\n        \/\/ P\u00e1gina normal\r\n        return 'normal';\r\n    }\r\n\r\n    \/\/ ====== CAPTURA E PERSIST\u00caNCIA DE UTMs NO LOCALSTORAGE ======\r\n    function getUTMsFromURL() {\r\n        const urlParams = new URLSearchParams(window.location.search);\r\n        return {\r\n            utm_source:   urlParams.get('utm_source')   || '',\r\n            utm_campaign: urlParams.get('utm_campaign') || '',\r\n            utm_medium:   urlParams.get('utm_medium')   || '',\r\n            utm_content:  urlParams.get('utm_content')  || '',\r\n            utm_term:     urlParams.get('utm_term')     || '',\r\n            utm_id:       urlParams.get('utm_id')       || '',\r\n            src:          urlParams.get('src')          || '',\r\n            sck:          urlParams.get('sck')          || '',\r\n            fbclid:       urlParams.get('fbclid')       || '',\r\n            fbc:          urlParams.get('fbc')          || '',\r\n            fbp:          urlParams.get('fbp')          || '',\r\n            xcod:         urlParams.get('xcod')         || '',\r\n            external_id:  urlParams.get('external_id')  || '',\r\n            currency:     urlParams.get('currency')     || '',\r\n            user_ip:      urlParams.get('user_ip')      || '',\r\n            user_agent:   urlParams.get('user_agent')   || navigator.userAgent,\r\n            country:      urlParams.get('country')      || '',\r\n            country_code: urlParams.get('country_code') || '',\r\n            region:       urlParams.get('region')       || '',\r\n            city:         urlParams.get('city')         || '',\r\n            latitude:     urlParams.get('latitude')     || '',\r\n            longitude:    urlParams.get('longitude')    || '',\r\n            timezone:     urlParams.get('timezone')     || '',\r\n            organization: urlParams.get('organization') || '',\r\n            asn:          urlParams.get('asn')          || ''\r\n        };\r\n    }\r\n\r\n    function saveUTMsToLocalStorage(utms) {\r\n        try {\r\n            localStorage.setItem('utm_cache', JSON.stringify(utms));\r\n            console.log(\"\u2705 UTMs salvas no localStorage:\", utms);\r\n        } catch (e) {\r\n            console.warn(\"\u26a0\ufe0f Erro ao salvar UTMs no localStorage:\", e);\r\n        }\r\n    }\r\n\r\n    \/\/ ====== INICIALIZA\u00c7\u00c3O ======\r\n    function initFacebookTracking() {\r\n        console.log(\"\ud83c\udfaf Iniciando rastreamento Facebook...\");\r\n        \r\n        const pageType = detectPageType();\r\n        console.log(\"\ud83d\udcc4 Tipo de p\u00e1gina detectado:\", pageType);\r\n        \r\n        \/\/ Sempre envia PageView\r\n        sendPageViewToFacebook();\r\n        \r\n        \/\/ Se for p\u00e1gina de vendas, tamb\u00e9m envia ViewContent\r\n        if (pageType === 'sales' || pageType === 'checkout') {\r\n            setTimeout(() => {\r\n                sendViewContentToFacebook();\r\n            }, 1000); \/\/ Aguarda 1 segundo ap\u00f3s PageView\r\n        }\r\n    }\r\n\r\n    \/\/ Inicializa\u00e7\u00e3o\r\n    (async function() {\r\n        \/\/ Aguarda o DOM estar pronto\r\n        if (document.readyState === 'loading') {\r\n            document.addEventListener('DOMContentLoaded', initFacebookTracking);\r\n        } else {\r\n            \/\/ DOM j\u00e1 est\u00e1 pronto\r\n            initFacebookTracking();\r\n        }\r\n\r\n        \/\/ CAPTURA E SALVA UTMs NA P\u00c1GINA INICIAL\r\n        const utms = getUTMsFromURL();\r\n        saveUTMsToLocalStorage(utms);\r\n\r\n        \/\/ Salva os UTMs no banco (exemplo de chamada para o backend)\r\n        try {\r\n            const response = await fetch('create-pix.php', {\r\n                method: 'POST',\r\n                headers: {\r\n                    'Content-Type': 'application\/json'\r\n                },\r\n                body: JSON.stringify({\r\n                    utm_params: utms\r\n                })\r\n            });\r\n\r\n            if (response.ok) {\r\n                console.log(\"\u2705 UTMs salvos com sucesso:\", utms);\r\n            } else {\r\n                console.error(\"\u274c Erro ao salvar UTMs:\", await response.json());\r\n            }\r\n        } catch (error) {\r\n            console.error(\"\u274c Erro na requisi\u00e7\u00e3o de salvamento de UTMs:\", error);\r\n        }\r\n    })();\r\n\r\n    \/\/ Exp\u00f5e fun\u00e7\u00f5es globalmente para uso manual se necess\u00e1rio\r\n    window.fbTracking = {\r\n        sendPageView: sendPageViewToFacebook,\r\n        sendViewContent: sendViewContentToFacebook\r\n    };\r\n\r\n    \/\/ ====== GERA\u00c7\u00c3O DE QR CODE PARA PIX ======\r\n    function generateQRCode(pixCode) {\r\n        if (!pixCode) {\r\n            console.error(\"\u274c C\u00f3digo PIX inv\u00e1lido para gera\u00e7\u00e3o de QR Code:\", pixCode);\r\n            return;\r\n        }\r\n\r\n        \/\/ Limpa canvas anterior\r\n        const canvas = document.getElementById('qr-code-canvas');\r\n        const ctx = canvas.getContext('2d');\r\n        ctx.clearRect(0, 0, canvas.width, canvas.height);\r\n\r\n        \/\/ Tenta gerar QR Code com a biblioteca\r\n        try {\r\n            const qr = qrcode.gen({\r\n                text: pixCode,\r\n                width: 180,\r\n                height: 180,\r\n                colorDark: \"#000000\",\r\n                colorLight: \"#ffffff\",\r\n                correctLevel: qrcode.CorrectLevel.H\r\n            });\r\n\r\n            \/\/ Desenha QR Code no canvas\r\n            const img = new Image();\r\n            img.src = qr;\r\n            img.onload = () => {\r\n                ctx.drawImage(img, 0, 0, 180, 180);\r\n            };\r\n        } catch (e) {\r\n            console.error(\"Erro ao gerar QR Code com a biblioteca:\", e);\r\n            drawFallbackIMG();\r\n        }\r\n\r\n        \/\/ Fun\u00e7\u00e3o para fallback em caso de erro na gera\u00e7\u00e3o do QR Code\r\n        function drawFallbackIMG() {\r\n            try {\r\n                \/\/ Novo provedor externo (quickchart.io)\r\n                const apiURL = `https:\/\/quickchart.io\/qr?size=180&text=${encodeURIComponent(pixCode)}`;\r\n                const img = new Image();\r\n                img.onload = () => {\r\n                    canvas.width = 180;\r\n                    canvas.height = 180;\r\n                    ctx.drawImage(img, 0, 0, 180, 180);\r\n                };\r\n                img.onerror = () => console.error(\"Falha fallback QR (quickchart.io)\");\r\n                img.src = apiURL;\r\n            } catch(e){ console.error(\"Erro fallback IMG quickchart:\", e); }\r\n        }\r\n    }\r\n\r\n    \/\/ Exemplo de uso da gera\u00e7\u00e3o de QR Code\r\n    document.getElementById('generate-qr-btn').addEventListener('click', () => {\r\n        const pixCode = document.getElementById('pix-code-input').value;\r\n        generateQRCode(pixCode);\r\n    });\r\n\r\n})();\r\n<\/script>\r\n\r\n<!-- \r\n====== INSTRU\u00c7\u00d5ES DE USO ======\r\n\r\nEste widget detecta automaticamente o tipo de p\u00e1gina e envia os eventos apropriados:\r\n\r\n\ud83d\udcc4 TODAS AS P\u00c1GINAS:\r\n- PageView (sempre enviado)\r\n\r\n\ud83d\uded2 P\u00c1GINAS DE VENDAS\/CHECKOUT:\r\n- PageView + ViewContent (detecta automaticamente)\r\n\r\n\ud83c\udfaf DETEC\u00c7\u00c3O AUTOM\u00c1TICA:\r\n- Busca por palavras-chave na URL e t\u00edtulo\r\n- Detecta elementos PIX na p\u00e1gina\r\n- Detecta par\u00e2metros de pre\u00e7o\/produto\r\n\r\n\ud83d\udca1 USO MANUAL (opcional):\r\n- window.fbTracking.sendPageView()\r\n- window.fbTracking.sendViewContent()\r\n\r\n\ud83d\udd27 CONFIGURA\u00c7\u00c3O:\r\n- J\u00e1 configurado com suas credenciais\r\n- Funciona mesmo com AdBlock\r\n- Gera cookies _fbc e _fbp automaticamente\r\n-->\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-a675890 elementor-widget elementor-widget-html\" data-id=\"a675890\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t\t<div class=\"elementor-widget-container\">\r\n    <script>\r\nconst delayEmSegundosVagas = 1;\r\nconst delayEmSegundosCompras = 1;\r\nconst manterVagasVisiveis = false;\r\n\r\nconst compras = [\r\n{\r\n    nome: \"Vanessa R.\",\r\n    tempo: \"45 minutos\",\r\n    pagamento: \"pix\",\r\n},\r\n{\r\n    nome: \"Raquel Silveira\",\r\n    tempo: \"22 minutos\",\r\n    pagamento: \"pix\",\r\n},\r\n{\r\n    nome: \"Roberta Cavalcante\",\r\n    tempo: \"32 minutos\",\r\n    pagamento: \"pix\",\r\n},\r\n{\r\n    nome: \"Ana R.\",\r\n    tempo: \"12 minutos\",\r\n    pagamento: \"Pix\",\r\n},\r\n{\r\n    nome: \"Marcela F.\",\r\n    tempo: \"51 minutos\",\r\n    pagamento: \"cart\u00e3o de d\u00e9bito\",\r\n},\r\n{\r\n    nome: \"Juliana D.\",\r\n    tempo: \"37 minutos\",\r\n    pagamento: \"pix\",\r\n},\r\n]\r\n\r\n<\/script>\r\n\r\n<style>\r\n:root {\r\n--cor-de-destaque: #f00;\r\n}\r\n\r\n\r\n\r\n\r\n#views b,\r\n#vagas b {\r\ncolor: var(--cor-de-destaque);\r\n}\r\n\r\n\r\n#vagas{\r\ndisplay: none;\r\n}\r\n\r\n\r\n#views {\r\nmax-width: 800px;\r\nmargin: auto;\r\nline-height: 1.4;\r\n}\r\n\r\n#toast-compras {\r\nposition: fixed;\r\nright: 20px;\r\nbottom: 20px;\r\nz-index: 1000;\r\nbackground-color: #FFF;\r\npadding: 10px 20px;\r\ndisplay: flex;\r\nalign-items: center;\r\njustify-content: center;\r\ngap: 20px;\r\nborder-radius: 5px;\r\nbox-shadow: 1px 1px 5px #00000036;\r\ntransform: translateY(calc(100% + 40px));\r\ntransition: all .3s ease;\r\nopacity: 0\r\n}\r\n#toast-compras.show {\r\ntransform: none;\r\nopacity: 1\r\n}\r\n#toast-compras * {\r\nfont-family: \"Roboto\", sans-serif\r\n}\r\n#toast-compras svg {\r\nwidth: 40px;\r\nheight: 40px;\r\nfill: #11F849;\r\nborder: 3px solid #11F849;\r\npadding: 5px;\r\nborder-radius: 100px\r\n}\r\n#toast-compras .textos .linha-1 {\r\ndisplay: flex;\r\ngap: 20px;\r\nalign-items: center;\r\nmargin: 0 0 5px\r\n}\r\n#toast-compras .textos .linha-1 .nome {\r\nfont-size: 16px;\r\nfont-weight: 500;\r\nline-height: 16px;\r\ncolor: #1b1b1b;\r\nmargin: 0\r\n}\r\n#toast-compras .textos .linha-1 .tempo {\r\nfont-size: 14px;\r\nfont-weight: 400;\r\nline-height: 14px;\r\ncolor: #7a7a7a;\r\nmargin: 0\r\n}\r\n#toast-compras .textos .pagamento {\r\nfont-size: 16px;\r\nline-height: 1;\r\ncolor: #7a7a7a;\r\nmargin: 0\r\n}\r\n\r\n<\/style>\r\n\r\n\r\n\r\n<div id=\"toast-compras\" class=\"\">\r\n<svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" viewBox=\"0 96.01 447.98 319.97\">\r\n<path d=\"M438.6 105.4C451.1 117.9 451.1 138.1 438.6 150.6L182.6 406.6C170.1 419.1 149.9 419.1 137.4 406.6L9.372 278.6C-3.124 266.1-3.124 245.9 9.372 233.4C21.87 220.9 42.13 220.9 54.63 233.4L159.1 338.7L393.4 105.4C405.9 92.88 426.1 92.88 438.6 105.4H438.6z\"><\/path>\r\n<\/svg>\r\n\r\n<div class=\"textos\">\r\n<div class=\"linha-1\">\r\n    <p class=\"nome\">Raquel Silveira<\/p>\r\n    <p class=\"tempo\">h\u00e1 22 minutos<\/p>\r\n<\/div>\r\n<p class=\"pagamento\">Doou no pix<\/p>\r\n<\/div>\r\n<\/div>\r\n\r\n\r\n\r\n<script>\r\nsetTimeout(() => {\r\nconfigurarVagas();\r\n}, delayEmSegundosVagas * 1000)\r\n\r\nsetTimeout(() => {\r\nmostrarToast();\r\n}, delayEmSegundosCompras * 1000)\r\n\r\n\r\ndocument.addEventListener('DOMContentLoaded', function(){\r\ninserirData();\r\nconfigurarViews();\r\n\r\nif(manterVagasVisiveis) exibirVagas();\r\n})\r\n\r\n\r\n\r\nfunction inserirLocalizacao() {\r\nfetch(\"https:\/\/wtfismyip.com\/json\").then(res => res.json().then((data) => {\r\n    const cidade = data.YourFuckingLocation.split(',')[0];\r\n    \r\n    document.querySelector('span#address').innerHTML = `de <b>${cidade}<\/b>`;\r\n}))\r\n}\r\n\r\nfunction exibirVagas(){\r\ndocument.querySelector('#vagas').style.display = \"block\";\r\n}\r\n\r\nfunction configurarVagas() {\r\nexibirVagas();\r\nconst vagasInterval = setInterval(() => {\r\n    const vagasElement = document.querySelector('#vagas b')\r\n    const vagas = Number(vagasElement.innerText);\r\n    \r\n    if(vagas >= 100) {\r\n        vagasElement.innerText = vagas - randomNumber(3, 8);\r\n    } else if(vagas >= 30) {\r\n        vagasElement.innerText = vagas - randomNumber(1, 3);\r\n    } else if(vagas >= 4) {\r\n        vagasElement.innerText = vagas - 1;\r\n    } else {\r\n        clearInterval(vagasInterval);\r\n    }\r\n    \r\n}, randomNumber(4, 8) * 1000);\r\n}\r\n\r\nfunction configurarViews() {\r\nconst viewsInterval = setInterval(() => {\r\n    const viewsElement = document.querySelector('#views b.qtd');\r\n    const views = Number(viewsElement.innerText);\r\n    \r\n    if(views <= 500) {\r\n        viewsElement.innerText = views + randomNumber(3, 8);\r\n    } else if(views >= 2300) {\r\n        viewsElement.innerText = views + randomNumber(-5, 5);\r\n    } else {\r\n        viewsElement.innerText = views + randomNumber(-3, 12);\r\n    }\r\n    \r\n}, 5 * 1000);\r\n}\r\n\r\nfunction mostrarToast() {\r\nconfigurarToast()\r\ndocument.querySelector('#toast-compras').classList.add('show');\r\n\r\nsetTimeout(() => {\r\n    document.querySelector('#toast-compras').classList.remove('show');\r\n    \r\n    setTimeout(() => {\r\n        mostrarToast();\r\n    }, randomNumber(5, 10) * 1000)\r\n}, 2500);\r\n}\r\n\r\nfunction configurarToast() {\r\ndocument.querySelector('#toast-compras .nome').innerText = compras[0].nome;\r\ndocument.querySelector('#toast-compras .tempo').innerText = `h\u00e1 ${compras[0].tempo}`;\r\ndocument.querySelector('#toast-compras .pagamento').innerText = `Doou no ${compras[0].pagamento}`;\r\n\r\ncompras.push(compras.shift());\r\n}\r\n\r\nfunction randomNumber(min, max) {\r\nmin = Math.ceil(min);\r\nmax = Math.floor(max);\r\nreturn Math.floor(Math.random() * (max - min + 1)) + min;\r\n}\r\n\r\n\r\nfunction inserirData() {\r\nconst data = new Date().toLocaleDateString();\r\ndocument.querySelector('#views b.date').innerText = data;\r\n}\r\n\r\n<\/script>\t\t<\/div>\r\n\r\n\t\t\t\t<\/div>\n